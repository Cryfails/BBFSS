#version 450
#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_vote : require

layout(local_size_x = 64) in;

layout(scalar, set = 0, binding = 0) readonly buffer Cb { uint d[]; } cbuf;
layout(set = 0, binding = 1) uniform sampler2D depth_tex;
layout(set = 0, binding = 2, rgba8) uniform image2D shadow_img;
layout(set = 0, binding = 3) uniform sampler2D shadow_map;
layout(scalar, set = 0, binding = 4) readonly buffer Ub { uint d[]; } ubuf;

layout(push_constant) uniform Constants {
    uint buf_off;
    uint frame_index;
    vec2 size;
    vec4 light_coordinate;
    ivec2 wave_offset;
    float surface_thickness;
    float bilinear_threshold;
    float strength;
    float shadow_contrast;
    uint debug;
    uint contact_on;
    uint pcss_on;
    float light_tan;
    float max_penumbra_m;
    float min_penumbra_m;
    float bias_m;
    uint filter_on;
    float cascade_blend;
    float bend_distance_scale; // 0: no fade (uniforms not bound)
};

#ifndef BLOCKER_TAPS
#define BLOCKER_TAPS 32
#endif
#ifndef FILTER_NEAR
#define FILTER_NEAR 12
#endif
#ifndef FILTER_MID
#define FILTER_MID 20
#endif
#ifndef FILTER_FAR
#define FILTER_FAR 32
#endif

const int WAVE_SIZE = 64;
const int SAMPLE_COUNT = 60;
const int HARD_SHADOW_SAMPLES = 4;
const int FADE_OUT_SAMPLES = 8;
const int READ_COUNT = SAMPLE_COUNT / WAVE_SIZE + 2;
shared float depth_data[READ_COUNT * WAVE_SIZE];
shared bool lds_early_out;

uint base;
float cb(int i) { return uintBitsToFloat(cbuf.d[base + uint(i)]); }
vec4 row(int i) { return vec4(cb(i), cb(i + 1), cb(i + 2), cb(i + 3)); }

float sceneDepth(vec2 uv) { return textureLod(depth_tex, uv, 0.0).x; }

bool fullyFaded;
mat4 invMat;
mat4 projMat;

vec3 viewPosAt(vec2 uv, float depth) {
    vec4 c = vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    vec4 v = invMat * c;
    return v.xyz / v.w;
}

float hash(vec2 p) {
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

float d0;
vec3 P0;
int cascade;
vec4 rA, rB, rW, rZ;
float lu, lv, lz;
vec2 tileMin, tileMax;
vec2 extent;
vec2 texelLo, texelHi;

bool setupCascade(int index) {
    cascade = index;
    tileMin = vec2(index & 1, index >> 1) * 0.5;
    tileMax = tileMin + 0.5;
    texelLo = floor(tileMin * extent);
    texelHi = floor(tileMax * extent) - 1.0;
    int m = 16 + 16 * index;
    mat4 rows = transpose(transpose(mat4(row(m), row(m + 4), row(m + 12), row(m + 8))) * projMat);
    rA = rows[0];
    rB = rows[1];
    rW = rows[2];
    rZ = rows[3];
    vec4 p4 = vec4(P0, 1.0);
    float wl = dot(rW, p4);
    if (abs(wl) < 1e-9) {
        return false;
    }
    lu = dot(rA, p4) / wl;
    lv = dot(rB, p4) / wl;
    lz = dot(rZ, p4) / wl;
    return true;
}

bool setup(vec2 uv0) {
    P0 = viewPosAt(uv0, d0);
    if (!(P0.z > 0.0)) return false;
    int index = int(P0.z > cb(80)) + int(P0.z > cb(81)) + int(P0.z > cb(82));
    return setupCascade(index);
}

void wavefrontExtents(out vec2 delta_xy, out vec2 pixel_xy, out float pixel_distance,
                      out bool major_axis_x, out bool center_wave, out bool center_thread) {
    ivec2 xy = ivec2(gl_WorkGroupID.yz) * WAVE_SIZE + wave_offset;
    vec2 light_xy = floor(light_coordinate.xy) + 0.5;
    vec2 light_fraction = light_coordinate.xy - light_xy;
    bool reverse_direction = light_coordinate.w > 0.0;

    ivec2 sign_xy = sign(xy);
    bool horizontal = abs(xy.x + sign_xy.y) < abs(xy.y - sign_xy.x);
    ivec2 axis = horizontal ? ivec2(sign_xy.y, 0) : ivec2(0, -sign_xy.x);
    xy += axis * int(gl_WorkGroupID.x);
    vec2 xy_f = vec2(xy);

    major_axis_x = abs(xy_f.x) > abs(xy_f.y);
    float major_axis = major_axis_x ? xy_f.x : xy_f.y;
    float major_axis_start = abs(major_axis);
    float major_axis_end = abs(major_axis) - float(WAVE_SIZE);
    float light_fraction_major = major_axis_x ? light_fraction.x : light_fraction.y;
    light_fraction_major = major_axis > 0.0 ? -light_fraction_major : light_fraction_major;

    vec2 start_xy = xy_f + light_xy;
    vec2 end_xy = mix(light_coordinate.xy, start_xy,
                      (major_axis_end + light_fraction_major) /
                          (major_axis_start + light_fraction_major));
    delta_xy = start_xy - end_xy;

    int lane = int(gl_LocalInvocationIndex);
    float thread_step = float(lane ^ (reverse_direction ? 0 : WAVE_SIZE - 1));
    center_wave = gl_NumWorkGroups.x == 1;
    center_thread = center_wave && gl_LocalInvocationIndex == 0;
    if (center_wave) {
        delta_xy = vec2(0.0);
        pixel_xy = light_coordinate.xy;
        pixel_distance = 1.0;
    } else {
        pixel_xy = mix(start_xy, end_xy, thread_step / float(WAVE_SIZE));
        pixel_distance = major_axis_start - thread_step + light_fraction_major;
    }
}

float bendContact(vec2 pixel_xy, vec2 delta_xy, float pixel_distance, bool major_axis_x,
                  float start, float native_alpha) {
    float shadowing_depth[READ_COUNT];
    float depth_thickness_scale[READ_COUNT];
    float sample_distance[READ_COUNT];
    const float direction = -light_coordinate.w;
    const float z_sign = 1.0;
    bool skip_trace = !(start < 1.0) || !(start > 0.0) ||
                      (debug == 0u && filter_on == 0u && native_alpha <= 1.0 - strength);

    for (int i = 0; i < READ_COUNT; ++i) {
        vec2 read_xy = floor(pixel_xy);
        float minor_axis = major_axis_x ? pixel_xy.y : pixel_xy.x;
        float bilinear = fract(minor_axis) - 0.5;
        float bias = bilinear > 0.0 ? 1.0 : -1.0;
        vec2 offset_xy = major_axis_x ? vec2(0.0, bias) : vec2(bias, 0.0);
        vec2 depths;
        depths.x = i == 0 ? start : textureLod(depth_tex, (read_xy + 0.5) / size, 0.0).x;
        depths.y = textureLod(depth_tex, (read_xy + 0.5 + offset_xy) / size, 0.0).x;

        depth_thickness_scale[i] = abs(1.0 - depths.x);
        bool use_point_filter =
            abs(depths.x - depths.y) > depth_thickness_scale[i] * bilinear_threshold;
        float shadow_depth = depths.x + abs(depths.x - depths.y) * z_sign;
        shadowing_depth[i] = use_point_filter ? depths.x : shadow_depth;
        sample_distance[i] = pixel_distance + float(WAVE_SIZE * i) * direction;
        pixel_xy += delta_xy * direction;
    }

    bool any_active = subgroupAny(!skip_trace);
    if (gl_SubgroupSize == WAVE_SIZE) {
        if (!any_active) {
            return 1.0;
        }
    } else {
        if (gl_LocalInvocationIndex == 0u) {
            lds_early_out = true;
        }
        barrier();
        if (any_active) {
            lds_early_out = false;
        }
        barrier();
        if (lds_early_out) {
            return 1.0;
        }
    }

    for (int i = 0; i < READ_COUNT; ++i) {
        float stored_depth = (shadowing_depth[i] - light_coordinate.z) / sample_distance[i];
        if (i != 0 && sample_distance[i] <= 0.0) {
            stored_depth = 1e10;
        }
        depth_data[i * WAVE_SIZE + int(gl_LocalInvocationIndex)] = stored_depth;
    }
    barrier();
    if (skip_trace) {
        return 1.0;
    }

    float start_depth = (start - light_coordinate.z) / sample_distance[0];
    int sample_index = int(gl_LocalInvocationIndex) + 1;
    vec4 shadow_value = vec4(1.0);
    float hard_shadow = 1.0;
    float depth_scale = min(sample_distance[0] + direction, 1.0 / surface_thickness) *
                        sample_distance[0] / depth_thickness_scale[0];
    start_depth = start_depth * depth_scale - z_sign;

    for (int i = 0; i < HARD_SHADOW_SAMPLES; ++i) {
        float depth_delta = abs(start_depth - depth_data[sample_index + i] * depth_scale);
        hard_shadow = min(hard_shadow, depth_delta);
    }
    for (int i = HARD_SHADOW_SAMPLES; i < SAMPLE_COUNT - FADE_OUT_SAMPLES; ++i) {
        float depth_delta = abs(start_depth - depth_data[sample_index + i] * depth_scale);
        shadow_value[i & 3] = min(shadow_value[i & 3], depth_delta);
    }
    for (int i = SAMPLE_COUNT - FADE_OUT_SAMPLES; i < SAMPLE_COUNT; ++i) {
        float depth_delta = abs(start_depth - depth_data[sample_index + i] * depth_scale);
        float fade = float(i + 1 - (SAMPLE_COUNT - FADE_OUT_SAMPLES)) /
                     float(FADE_OUT_SAMPLES + 1) * 0.75;
        shadow_value[i & 3] = min(shadow_value[i & 3], depth_delta + fade);
    }

    shadow_value = clamp(shadow_value * shadow_contrast + (1.0 - shadow_contrast), 0.0, 1.0);
    hard_shadow = clamp(hard_shadow * shadow_contrast + (1.0 - shadow_contrast), 0.0, 1.0);
    return min(hard_shadow, dot(shadow_value, vec4(0.25)));
}

bool lightCoords(vec2 uv, out vec3 l, out float viewZ) {
    float d = sceneDepth(uv);
    if (!(d < 1.0) || !(d > 0.0)) {
        return false;
    }
    vec3 P = viewPosAt(uv, d);
    vec4 p4 = vec4(P, 1.0);
    float wl = dot(rW, p4);
    if (abs(wl) < 1e-9) {
        return false;
    }
    l = vec3(dot(rA, p4), dot(rB, p4), dot(rZ, p4)) / wl;
    viewZ = P.z;
    return true;
}

vec2 vogel(int i, int n, float phi) {
    float r = sqrt((float(i) + 0.5) / float(n));
    float a = float(i) * 2.399963 + phi;
    return r * vec2(cos(a), sin(a));
}

float mapDepth(vec2 uv) {
    return texelFetch(shadow_map, ivec2(clamp(floor(uv * extent), texelLo, texelHi)), 0).x;
}

float compareBilinear(vec2 uv, vec2 center, vec2 slope, float bias) {
    vec2 p = uv * extent - 0.5;
    vec2 origin = clamp(floor(p), texelLo, texelHi - 1.0);
    vec2 f = fract(p);
    vec2 step_uv = 1.0 / extent;
    float receiver = lz + dot(slope, (origin + 0.5) * step_uv - center) - bias;
    vec2 d = slope * step_uv;
    vec4 limit = receiver + vec4(d.y, d.x + d.y, d.x, 0.0);
    vec4 lit = vec4(greaterThanEqual(textureGather(shadow_map, (origin + 1.0) * step_uv, 0), limit));
    return mix(mix(lit.w, lit.z, f.x), mix(lit.x, lit.y, f.x), f.y);
}

float pcss(vec2 uv0) {
    vec2 texel = 1.0 / extent;
    vec2 center = vec2(lu, lv);
    if (any(lessThan(center, tileMin)) || any(greaterThanEqual(center, tileMax)) ||
        !(lz >= 0.0 && lz <= 1.0)) return -1.0;

    float gu = length(rA.xyz - lu * rW.xyz);
    float gv = length(rB.xyz - lv * rW.xyz);
    float gz = length(rZ.xyz - lz * rW.xyz);
    if (!(gu > 1e-9) || !(gv > 1e-9) || !(gz > 1e-9)) {
        return -1.0;
    }
    if (fullyFaded) return 1.0;

    vec2 slope = vec2(0.0);
    vec3 l1, l2;
    float z1, z2;
    vec2 px = 1.0 / size;
    if (lightCoords(uv0 + vec2(px.x, 0.0), l1, z1) && lightCoords(uv0 + vec2(0.0, px.y), l2, z2)) {
        float tol = 0.1 + 0.02 * P0.z;
        if (abs(z1 - P0.z) < tol && abs(z2 - P0.z) < tol) {
            vec3 e1 = l1 - vec3(lu, lv, lz);
            vec3 e2 = l2 - vec3(lu, lv, lz);
            float det = e1.x * e2.y - e2.x * e1.y;
            if (abs(det) > 1e-14) {
                slope = vec2(e1.z * e2.y - e2.z * e1.y, e1.x * e2.z - e2.x * e1.z) / det;
                float limit = 3.0 * gz / min(gu, gv);
                slope = clamp(slope, vec2(-limit), vec2(limit));
            }
        }
    }

    vec2 uvPerMetre = vec2(gu, gv);
    float worldTexel = max(texel.x / gu, texel.y / gv);
    float bias = min(bias_m, 0.5 * worldTexel) * gz;
    float phi = 6.2831853 * hash(uv0 * size + 17.0);

    if (pcss_on == 0u) {
        float lit = 0.0;
        for (int i = 0; i < 8; ++i) {
            vec2 off = vogel(i, 8, phi) * (1.5 * texel);
            lit += compareBilinear(center + off, center, slope, bias);
        }
        return lit / 8.0;
    }

    vec2 searchRadius = max_penumbra_m * uvPerMetre;
    float blockerSum = 0.0;
    int blockers = 0;
    for (int i = 0; i < BLOCKER_TAPS; ++i) {
        float radius = sqrt(float(i) / float(BLOCKER_TAPS - 1));
        float angle = float(i) * 2.399963 + phi;
        vec2 off = radius * vec2(cos(angle), sin(angle)) * searchRadius;
        vec2 sampleUv = clamp(center + off, tileMin + 0.5 * texel, tileMax - 0.5 * texel);
        vec2 sampledUv = (floor(sampleUv / texel) + 0.5) * texel;
        float plane = dot(slope, sampledUv - center);
        float receiver = lz + plane;
        float sz = mapDepth(sampleUv);
        if (sz < receiver - bias) {
            blockerSum += sz - plane;
            ++blockers;
        }
    }
    if (blockers == 0) {
        return 1.0;
    }
    if (blockers == BLOCKER_TAPS) {
        return 0.0;
    }

    float blockerDist = max(lz - blockerSum / float(blockers), 0.0) / gz;
    float penumbra = clamp(blockerDist * light_tan, min_penumbra_m, max_penumbra_m);

    vec2 filterRadius = max(penumbra * uvPerMetre, 0.5 * texel);
    float radiusTexels = max(filterRadius.x / texel.x, filterRadius.y / texel.y);
    int filterTaps = radiusTexels <= 1.0 ? FILTER_NEAR : radiusTexels <= 4.0 ? FILTER_MID : FILTER_FAR;
    float lit = 0.0;

    for (int i = 0; i < filterTaps; ++i) {
        vec2 off = vogel(i, filterTaps, phi + 1.7) * filterRadius;
        lit += compareBilinear(center + off, center, slope, bias);
    }
    return lit / float(filterTaps);
}

void main() {
    base = (buf_off & 0xffu) >> 2;

    vec2 delta_xy, pixel_xy;
    float pixel_distance;
    bool major_axis_x;
    ivec2 pixel;
    bool valid_pixel;
    if (contact_on != 0u) {
        // Bend's wavefront layout: each workgroup walks one projected light ray.
        bool center_wave, center_thread;
        wavefrontExtents(delta_xy, pixel_xy, pixel_distance, major_axis_x, center_wave,
                         center_thread);
        pixel = ivec2(floor(pixel_xy));
        valid_pixel = all(greaterThanEqual(pixel, ivec2(0))) &&
                      all(lessThan(pixel, ivec2(size))) && (!center_wave || center_thread);
    } else {
        // Shadow-map filter only: one thread per pixel, in rows of 64.
        pixel = ivec2(gl_WorkGroupID.x * uint(WAVE_SIZE) + gl_LocalInvocationIndex,
                      gl_WorkGroupID.y);
        valid_pixel = all(lessThan(pixel, ivec2(size)));
    }
    vec2 uv = (vec2(pixel) + 0.5) / size;
    d0 = valid_pixel ? sceneDepth(uv) : 1.0;
    vec4 c = valid_pixel ? imageLoad(shadow_img, pixel) : vec4(1.0);

    // Every thread of a Bend wavefront takes part (shared depth samples and barriers), even
    // off-screen or sky ones.
    float contact = 1.0;
    if (contact_on != 0u) {
        contact = bendContact(pixel_xy, delta_xy, pixel_distance, major_axis_x, d0, c.a);
    }
    if (!valid_pixel || !(d0 < 1.0) || !(d0 > 0.0)) {
        return;
    }

    invMat = transpose(mat4(row(0), row(4), row(8), row(12)));
    const uint ub = ((buf_off >> 8) & 0xffu) >> 2;
    if (contact_on != 0u && debug == 0u) {
        // Fade the Bend shadows out with the game's sun-shadow distance fade, stretched
        // bend_distance_scale times further, so they don't run on past the shadow map
        // (unfaded, distant foliage flickered in the Elden Ring port).
        float fade = 1.0;
        if (bend_distance_scale > 0.0) {
            float dist = length(viewPosAt(uv, d0));
            fade = clamp(uintBitsToFloat(ubuf.d[ub + 73u]) *
                             (uintBitsToFloat(ubuf.d[ub + 72u]) - dist / bend_distance_scale),
                         0.0, 1.0);
        }
        contact = 1.0 - strength * fade * (1.0 - contact);
    }

    float alpha = c.a;
    if (filter_on != 0u) {
        extent = vec2(textureSize(shadow_map, 0));
        projMat = inverse(invMat);
        if (!setup(uv)) {
            return;
        }
        float fade = clamp(uintBitsToFloat(ubuf.d[ub + 73u]) *
                               (uintBitsToFloat(ubuf.d[ub + 72u]) - length(P0)),
                           0.0, 1.0);

        fullyFaded = fade == 0.0;
        float vis = pcss(uv);
        int primary = cascade;
        if (!fullyFaded && vis >= 0.0 && primary < 3 && cascade_blend > 0.0) {
            float split = cb(80 + primary);
            float previous = primary == 0 ? 0.0 : cb(79 + primary);
            float band = cascade_blend * max(split - previous, 0.0);
            if (band > 0.0 && P0.z > split - band && setupCascade(primary + 1)) {
                float next = pcss(uv);
                if (next >= 0.0)
                    vis = mix(vis, next, smoothstep(split - band, split, P0.z));
            }
        }
        if (vis >= 0.0) {
            alpha = 1.0 - fade * (1.0 - vis);
        }
    }
    if (contact_on != 0u) {
        alpha = debug != 0u ? contact : min(alpha, contact);
    }
    c.a = alpha;
    imageStore(shadow_img, pixel, c);
}
