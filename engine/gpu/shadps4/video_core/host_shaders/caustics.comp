// bbport (r107_caustics): water caustics from the sun or moon (BB_CAUSTICS; vk_caustics.cpp, the
// numbers in caustics_layout.h). One dispatch over the scene at its render size, at the first
// blended draw after the opaque scene (after the indirect light; before the transparents and the
// fog).
//
// Where: only in frames whose G-buffer passes are the world and its mirror image in a water plane
// (the game's planar reflection: the sewers, Gascoigne's arena); the plane's height comes from the
// two cameras (CameraMotion::MirrorPlane). A pixel P from CAUSTICS_MIN_HEIGHT to MAX_HEIGHT above
// the plane takes light the water reflects: the sun's light reflected off a flat plane travels
// along r = (-s.x, s.y, -s.z) (s toward the sun), so P's water point is Q = P - r * height / r.y.
// P is drawn when it faces r (normal from the depth), Q lies on the screen, Q is water (Water():
// nothing in front of it, and the surface there is not above the plane: the water, or the ground
// under it seen through it), Q's light set has the sun (bbport (r107b_caustics-visible): the
// game lights a roofed place with a light set without sun, while its sun shadow there says lit:
// the roof is no sun caster), and the game's screen shadow target (its alpha, the sun's
// visibility the game's sun light reads) says Q is lit.
// What: P's colour times 1 + gain * w * (c - 1): c the caustic pattern at Q (two layers of ridged
// value noise on the water, drifting, mean 1, so light is moved, not added), w = facing * lit at
// Q * exp(-path / falloff), faded out with distance.
// bbport (r107b_caustics-visible): lamps (CAUSTICS_FLAG_LAMPS, up to CAUSTICS_MAX_LAMPS a frame
// from the game's light grid): a lamp's light reflected off the plane arrives at P as from the lamp
// mirrored in the plane; where that path crosses the plane (X) is water, light is ADDED: albedo x
// colour x (1 - d / reach)^2 x facing x Schlick reflectance x the pattern at X x gain.
// Test view (CAUSTICS_FLAG_SHOW): sun-drawn pixels tinted cyan, band pixels whose Q is not water
// orange, those whose Q is in shadow or has no sun in its light set blue, puddle candidates
// magenta, pixels lit by lamp caustics green; pixels a lamp's reflected light reaches but whose
// crossings are not water (none lit) orange too.
// bbport (r107c_caustics-lamp-gain): a lamp's light added is its own direct light at the reflected
// path's length and angle (the game's lamp curve, CAUSTICS_DATA_CORE2) x the water's share
// 1 - exp(-gain x Schlick x pattern), below 1. Orange only where the water point or crossing is on
// dry ground; off the screen or hidden behind something nearer: grey (the screen cannot tell).
// bbport (r107d_caustics-lamp-look): the look (CAUSTICS_DATA_LOOK, BB_CAUSTICS_LAMPS above 1)
// multiplies all the light a receiver near lit water has by the pattern's contrast (mean 1;
// caustics_layout.h); the log's bins of the modelled lamp light over the pixel's own.
// bbport (r107e_caustics-puddles): puddles (CAUSTICS_FLAG_PUDDLE: frames without a mirrored water
// pass, BB_CAUSTICS_LAMPS on): every pixel facing up (world normal y from CAUSTICS_PUDDLE_UP) with
// the G-buffer's gloss from CAUSTICS_PUDDLE_GLOSS is a puddle candidate, counted by its height
// under the camera; the host takes the puddle plane from those counts (caustics_params.h
// EstimatePuddle) and gives it as sun.w (CAUSTICS_FLAG_PUDDLE_PLANE), with the up-facing pixels on
// it and the candidates among them counted (the guard against a glossy dry floor). A lamp's
// crossing is water only where its pixel is a candidate on the plane; the pattern there drifts
// CAUSTICS_PUDDLE_SPEED as fast and has CAUSTICS_PUDDLE_CONTRAST of its contrast (still water).
// bbport (r107f_caustics-world-anchored): BB_CAUSTICS_WORLD (CAUSTICS_FLAG_WORLD): a world map of what
// the water is (binding 7; caustics_layout.h): the up-facing pixels on the plane write their cell, a
// lamp's crossing the screen cannot see (off it, hidden) reads it, so the net has no holes where the
// hunter or the screen's edge hides the water. Water pixels of a mirrored plane get the lamps' light
// on the bed under them, a puddle's pixels the ripple (CAUSTICS_RIPPLE_*).
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require

#include "caustics_layout.h"

layout(local_size_x = CAUSTICS_GROUP, local_size_y = CAUSTICS_GROUP) in;

layout(binding = 0, rgba16f) uniform image2D scene_img;
layout(binding = 1) uniform texture2D depth_tex;    // D32, depth 0..1
layout(binding = 2) uniform texture2D shadow_tex;   // the game's screen shadow target (.a: lit)
layout(binding = 3) uniform texture2D material_tex; // G-buffer cb1 (.r: gloss)
layout(binding = 4, std430) buffer Counters {
    uint counts[];
};
layout(binding = 5) uniform texture2D albedo_tex;  // G-buffer cb2 (.rgb: albedo)
layout(binding = 6) uniform texture2D records_tex; // G-buffer cb3 (.a: the pixel's light set)
// bbport (r107f_caustics-world-anchored): the world map, one word a cell (the generation x 4 + state).
layout(binding = 7, std430) buffer WorldMap {
    uint world_map[];
};

// bbport (r130e_sewer-water-moves): the copy of the mirrored plane's water colours (the host binds the scene view as a stand-in
// when no warp runs; the shader touches it only under the two warp flags).
layout(binding = 8, rgba16f) uniform image2D warp_img;
layout(binding = 9) uniform texture2D bed_tex; // native R32F copy before the water depth write
// caustics_params.h Push, field for field (128 bytes).
layout(push_constant) uniform Push {
    vec4 proj;  // x scale, y scale, z scale, z offset
    vec4 frame; // width, height, jitter x, jitter y (pixels)
    vec4 inv0;  // view to world, 3x4 rows
    vec4 inv1;
    vec4 inv2;
    vec4 sun;   // xyz: world direction toward the sun or moon (unit); w: the water plane's world y
    vec4 drift; // layer 1 offset x, z; layer 2 offset x, z (m)
    float gain;
    float evolve; // the pattern's time axis, cells
    uint flags;
    uint slot;
};

shared uint group_counts[CAUSTICS_SLOT_WORDS];
shared uint group_ring; // r130b: the water pixels in this group a ring packet reached
shared uint group_warp[2]; // r130e: the water pixels this group's WARP threads took a colour for, and those they left as they were

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);
const vec3 TINT_DRAWN = vec3(0.15, 0.85, 1.0);
const vec3 TINT_DRY = vec3(1.0, 0.55, 0.1);
const vec3 TINT_SHADE = vec3(0.2, 0.3, 1.0);
const vec3 TINT_PUDDLE = vec3(1.0, 0.2, 0.9);
const vec3 TINT_LAMP = vec3(0.2, 1.0, 0.15);
const vec3 TINT_UNSEEN = vec3(0.5); // r107c: grey (Tinted keeps the brightness)
// Water(): what the screen shows at a point of the plane.
const int AT_WATER = 0, AT_BELOW = 1, AT_OFF = 2, AT_HIDDEN = 3, AT_DRY = 4;

#ifdef BB_BED_OBSERVER
// Each destination selects only its own stage/point row. Donor tests never write it.
uint bed_observer_row = 0u;

void ObserveBedEnter(ivec2 p, uint stage) {
    uint point = BED_OBS_NPOINTS;
    for (uint i = 0u; i < BED_OBS_NPOINTS; ++i) {
        const uint address = BED_OBS_POINTS + 2u * i;
        if (all(equal(uvec2(p), uvec2(counts[address], counts[address + 1u])))) point = i;
    }
    if (point != BED_OBS_NPOINTS) {
        bed_observer_row = BED_OBS_BASE + (stage * BED_OBS_NPOINTS + point) * BED_OBS_WORDS;
        counts[bed_observer_row + BED_OBS_ENTRY] = BED_OBS_MAGIC;
        counts[bed_observer_row + BED_OBS_READS] = 0u;
        counts[bed_observer_row + BED_OBS_STORE] = BED_STORE_NONE;
    }
}

void ObserveBedUint(uint field, uint value) {
    if (bed_observer_row != 0u) counts[bed_observer_row + field] = value;
}

void ObserveBedRgb(uint field, vec3 value) {
    if (bed_observer_row != 0u) {
        counts[bed_observer_row + field] = floatBitsToUint(value.x);
        counts[bed_observer_row + field + 1u] = floatBitsToUint(value.y);
        counts[bed_observer_row + field + 2u] = floatBitsToUint(value.z);
    }
}

vec4 ObserveBedStore(vec4 value, uint target) {
    ObserveBedRgb(BED_OBS_OPERAND, value.rgb);
    ObserveBedUint(BED_OBS_OPERAND + 3u, floatBitsToUint(value.a));
    ObserveBedUint(BED_OBS_STORE, target);
    return value;
}

bool ObserveBedTest(bool passed, uint field, uint refusal) {
    if (!passed) ObserveBedUint(field, refusal);
    return passed;
}

#define BED_U(field, value) ObserveBedUint(field, value);
#define BED_F(field, value) ObserveBedUint(field, floatBitsToUint(value));
#define BED_RGB(field, value) ObserveBedRgb(field, value);
#define BED_TEST(test, field, refusal) ObserveBedTest((test), field, refusal)
#define BED_STORE(target, pixel, value, kind) imageStore(target, pixel, ObserveBedStore(value, kind));
#define BED_DST_PARAM , bool bed_destination
#define BED_DST_ARG(value) , value
#define BED_POSITION_PARAM , uint bed_sample
#define BED_POSITION_ARG(value) , value
#else
#define BED_U(field, value)
#define BED_F(field, value)
#define BED_RGB(field, value)
#define BED_TEST(test, field, refusal) (test)
#define BED_STORE(target, pixel, value, kind) imageStore(target, pixel, value);
#define BED_DST_PARAM
#define BED_DST_ARG(value)
#define BED_POSITION_PARAM
#define BED_POSITION_ARG(value)
#endif

// As heat_haze.comp's (and caustics_params.h's C++ twin).
uint Hash(uvec3 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z;
    return v.x;
}

float Corner(ivec3 c) {
    return float(Hash(uvec3(c & 1023)) >> 8u) * (1.0 / 16777216.0);
}

// Value noise in [0, 1), smooth (quintic) between the lattice's corners.
float Noise(vec3 p) {
    const vec3 f = floor(p);
    const ivec3 i = ivec3(f);
    const vec3 u = p - f;
    const vec3 s = u * u * u * (u * (u * 6.0 - 15.0) + 10.0);
    const float x00 = mix(Corner(i), Corner(i + ivec3(1, 0, 0)), s.x);
    const float x10 = mix(Corner(i + ivec3(0, 1, 0)), Corner(i + ivec3(1, 1, 0)), s.x);
    const float x01 = mix(Corner(i + ivec3(0, 0, 1)), Corner(i + ivec3(1, 0, 1)), s.x);
    const float x11 = mix(Corner(i + ivec3(0, 1, 1)), Corner(i + ivec3(1, 1, 1)), s.x);
    return mix(mix(x00, x10, s.y), mix(x01, x11, s.y), s.z);
}

// 1 on the noise's 0.5 contour, 0 at its extremes: thin bright lines where it is sharpened.
float Ridge(vec3 p) {
    return 1.0 - abs(2.0 * Noise(p) - 1.0);
}

// bbport (r130b_water-moves): the moving water. The slot's motion block (caustics_layout.h CAUSTICS_MOTION_*), written by the host.
uint Motion(uint i) {
    return counts[CAUSTICS_MOTION_BASE + slot * CAUSTICS_MOTION_WORDS + i];
}

bool ring_hit = false; // WaveAt evaluated a ring packet (its last call)

// The wave field at a point of the water (world x, z): returns its curvature (the Laplacian of eta), `g` its slope (the gradient).
// 4 waves eta = A sin(k . xz - phase) and the rings' packets f(s) of the radius: f = G E C, G = a exp(-age / tau) / sqrt(1 + r / r0),
// E = exp(-s^2 / 2 w^2), C = cos(K s), s = r - speed x age; f' and f'' analytic (G' = -G / (2 (r0 + r)), G'' = 0.75 G / (r0 + r)^2).
float WaveAt(vec2 xz, out vec2 g) {
    g = vec2(0.0);
    float lap = 0.0;
    ring_hit = false;
    for (uint i = 0u; i < uint(CAUSTICS_MOTION_WAVES); ++i) {
        const uint at = uint(CAUSTICS_MOTION_WAVES_AT) + i * uint(CAUSTICS_MOTION_WAVE_WORDS);
        const vec2 kv = vec2(uintBitsToFloat(Motion(at)), uintBitsToFloat(Motion(at + 1u)));
        const float amp = uintBitsToFloat(Motion(at + 2u));
        const float th = dot(kv, xz) - uintBitsToFloat(Motion(at + 3u));
        g += (amp * cos(th)) * kv;
        lap -= amp * dot(kv, kv) * sin(th);
    }
    const uint rings = min(Motion(CAUSTICS_MOTION_RINGS), uint(CAUSTICS_MOTION_MAX_RINGS));
    for (uint j = 0u; j < rings; ++j) {
        const uint at = uint(CAUSTICS_MOTION_RINGS_AT) + j * uint(CAUSTICS_MOTION_RING_WORDS);
        const float age = uintBitsToFloat(Motion(at + 2u));
        const vec2 d = xz - vec2(uintBitsToFloat(Motion(at)), uintBitsToFloat(Motion(at + 1u)));
        const float r = length(d);
        const float s = r - CAUSTICS_RING_SPEED * age;
        if (abs(s) >= 3.0 * CAUSTICS_RING_WIDTH || r < 1e-4 || age >= CAUSTICS_RING_LIFE) {
            continue;
        }
        const float w2 = CAUSTICS_RING_WIDTH * CAUSTICS_RING_WIDTH;
        const float gain = uintBitsToFloat(Motion(at + 3u)) * exp(-age / CAUSTICS_RING_TAU) * inversesqrt(1.0 + r / CAUSTICS_RING_R0);
        const float e = exp(-0.5 * s * s / w2);
        const float c = cos(CAUSTICS_RING_K * s), sn = sin(CAUSTICS_RING_K * s);
        const float h0 = e * c;
        const float h1 = e * (-(s / w2) * c - CAUSTICS_RING_K * sn);
        const float h2 = e * (c * (s * s / (w2 * w2) - 1.0 / w2 - CAUSTICS_RING_K * CAUSTICS_RING_K) +
                              2.0 * s * CAUSTICS_RING_K * sn / w2);
        const float g1 = -0.5 * gain / (CAUSTICS_RING_R0 + r);
        const float g2 = 0.75 * gain / ((CAUSTICS_RING_R0 + r) * (CAUSTICS_RING_R0 + r));
        const float f1 = g1 * h0 + gain * h1;
        const float f2 = g2 * h0 + 2.0 * g1 * h1 + gain * h2;
        g += f1 * (d / r);
        lap += f2 + f1 / max(r, 0.02);
        ring_hit = true;
    }
    return lap;
}

// The caustic brightness the curvature gives (mean 1: a hollow focuses, a crest spreads).
float Focus(float lap) {
    return clamp(1.0 - CAUSTICS_MOTION_FOCUS * lap, 0.0, 3.0);
}

// The caustic pattern at a point of the water (world x, z), mean 1 (CAUSTICS_PATTERN_MEAN).
// r107e: `speed` scales its drift and its change over time (1: as before).
float PatternAt(vec2 xz, float speed, bool moving) {
    // The waves bend the pattern position and change its focus.
    float c = 1.0;
    if (moving) {
        vec2 slope;
        const float lap = WaveAt(xz, slope);
        xz += CAUSTICS_MOTION_WARP * slope;
        c = Focus(lap);
    }
    const vec2 a = (xz + drift.xy * speed) * (1.0 / CAUSTICS_LAMBDA1);
    const vec2 m = xz + drift.zw * speed;
    const vec2 b = vec2(CAUSTICS_COS2 * m.x - CAUSTICS_SIN2 * m.y,
                        CAUSTICS_SIN2 * m.x + CAUSTICS_COS2 * m.y) *
                   (1.0 / CAUSTICS_LAMBDA2);
    const float r1 = Ridge(vec3(a, evolve * speed));
    const float r2 = Ridge(vec3(b, evolve * speed * CAUSTICS_EVOLVE2 + CAUSTICS_EVOLVE2_SHIFT));
    const float net = 0.5 * (pow(r1, CAUSTICS_SHARP) + pow(r2, CAUSTICS_SHARP)) * (1.0 / CAUSTICS_PATTERN_MEAN);
    return net * c; // r130b: c is 1.0 without the motion flag
}

float Pattern(vec2 xz, float speed) {
    return PatternAt(xz, speed, (flags & CAUSTICS_FLAG_MOTION) != 0u);
}

float ViewZ(float depth) {
    return proj.w / min(depth - proj.z, -1e-8);
}

// The view position seen at `pixel` (its centre: + 0.5) at view depth z; the jitter taken out.
vec3 ViewPos(vec2 pixel, float z) {
    const vec2 ndc = (pixel - frame.zw) / frame.xy * 2.0 - 1.0;
    return vec3(ndc.x * z / proj.x, ndc.y * z / proj.y, z);
}

vec3 ViewAt(ivec2 p) {
    return ViewPos(vec2(p) + 0.5, ViewZ(texelFetch(depth_tex, p, 0).r));
}

vec3 ToWorld(vec3 v) {
    const vec4 h = vec4(v, 1.0);
    return vec3(dot(inv0, h), dot(inv1, h), dot(inv2, h));
}

vec3 DirToWorld(vec3 v) {
    return vec3(dot(inv0.xyz, v), dot(inv1.xyz, v), dot(inv2.xyz, v));
}

// World to view: the view to world rotation's transpose (a camera turns and moves, it does not
// scale), after taking off the camera's position.
vec3 ToView(vec3 w) {
    const vec3 d = w - vec3(inv0.w, inv1.w, inv2.w);
    return vec3(dot(vec3(inv0.x, inv1.x, inv2.x), d), dot(vec3(inv0.y, inv1.y, inv2.y), d),
                dot(vec3(inv0.z, inv1.z, inv2.z), d));
}

// The surface's view normal from the depth, facing the camera: on each axis the neighbour whose
// depth is nearer the pixel's (an edge does not bend it). Zero at the screen's border.
vec3 NormalAt(ivec2 p, vec3 P) {
    const ivec2 last = ivec2(frame.xy) - 1;
    if (any(lessThanEqual(p, ivec2(0))) || any(greaterThanEqual(p, last))) {
        return vec3(0.0);
    }
    const vec3 r = ViewAt(p + ivec2(1, 0)), l = ViewAt(p - ivec2(1, 0));
    const vec3 d = ViewAt(p + ivec2(0, 1)), u = ViewAt(p - ivec2(0, 1));
    const vec3 dx = abs(r.z - P.z) < abs(P.z - l.z) ? r - P : P - l;
    const vec3 dy = abs(d.z - P.z) < abs(P.z - u.z) ? d - P : P - u;
    const vec3 n = cross(dy, dx);
    const float len = length(n);
    if (!(len > 1e-12)) {
        return vec3(0.0);
    }
    return dot(n, P) > 0.0 ? -n / len : n / len;
}

vec3 Tinted(vec3 rgb, vec3 tint, float k) {
    const float luma = max(dot(max(rgb, vec3(0.0)), LUMA), 0.05);
    return mix(rgb, tint * (luma / dot(tint, LUMA)), k);
}

// bbport (r107b_caustics-visible): what the screen shows at the plane's point W (world): AT_WATER
// the depth lies on the plane there (the water is in the depth), AT_BELOW below it (the ground
// under the water, seen through it: the water is not in the depth yet), AT_OFF off the screen or
// the sky, AT_HIDDEN something nearer stands in front of it, AT_DRY a surface above the plane
// (dry ground). `qi`, `q`: W's pixel.
int Water(vec3 W, out ivec2 qi, out vec2 q) {
    const vec3 Wv = ToView(W);
    q = (Wv.xy * proj.xy / max(Wv.z, 1e-4) + 1.0) * 0.5 * frame.xy + frame.zw;
    qi = ivec2(0);
    if (!(Wv.z > 0.05) || any(lessThan(q, vec2(0.0))) || any(greaterThanEqual(q, frame.xy))) {
        return AT_OFF;
    }
    qi = ivec2(q);
    const float dq = texelFetch(depth_tex, qi, 0).r;
    if (dq >= 1.0) {
        return AT_OFF;
    }
    const float zq = ViewZ(dq);
    const float above = ToWorld(ViewPos(vec2(qi) + 0.5, zq)).y - sun.w;
    const float tolerance = CAUSTICS_WATER_M + CAUSTICS_WATER_REL * zq;
    // r107c: a nearer surface on the plane is the water itself (nearer only by the plane's error).
    if (zq < Wv.z - (CAUSTICS_SEEN_M + CAUSTICS_SEEN_REL * Wv.z) && abs(above) > tolerance) {
        return AT_HIDDEN;
    }
    return above > tolerance ? AT_DRY : above >= -tolerance ? AT_WATER : AT_BELOW;
}

// A texel of `tex` at the scene's pixel `qi` (`q` its position), at the texture's own size when it
// is not the scene's.
ivec2 TexelOf(texture2D tex, ivec2 qi, vec2 q) {
    const ivec2 size = textureSize(tex, 0);
    ivec2 t = qi;
    if (any(greaterThanEqual(t, size))) {
        t = ivec2(q / frame.xy * vec2(size));
    }
    return min(t, size - 1);
}

// bbport (r107e_caustics-puddles): a puddle candidate at the scene's pixel `q`: facing up and glossy.
bool PuddleAt(ivec2 q) {
    if (texelFetch(material_tex, TexelOf(material_tex, q, vec2(q) + 0.5), 0).r < CAUSTICS_PUDDLE_GLOSS) {
        return false;
    }
    return DirToWorld(NormalAt(q, ViewAt(q))).y >= CAUSTICS_PUDDLE_UP;
}

uint Data(uint i) {
    return counts[CAUSTICS_SLOTS * CAUSTICS_SLOT_WORDS + slot * CAUSTICS_DATA_WORDS + i];
}

// bbport (r107c_caustics-lamp-gain): the game's lamp curve at x = d / reach (below 1): the
// inverse-square curve its lamp shaders are patched to, or its own (1 - x)^2 (core squared < 0).
float LampCurve(float x) {
    const float core2 = uintBitsToFloat(Data(CAUSTICS_DATA_CORE2));
    if (core2 < 0.0) {
        return (1.0 - x) * (1.0 - x);
    }
    return uintBitsToFloat(Data(CAUSTICS_DATA_ENERGY)) *
           max(1.0 / max(x * x + core2, 1e-6) - 1.0 / (1.0 + core2), 0.0);
}

// bbport (r107f_caustics-world-anchored): the world map's cell of the world point (x, z), wrapped.
uint MapIndex(vec2 xz) {
    const ivec2 c = ivec2(floor(xz * CAUSTICS_MAP_CELLS_PER_M)) & (CAUSTICS_MAP_SIZE - 1);
    return uint(c.y * CAUSTICS_MAP_SIZE + c.x);
}

// What the cell holds in this plane's generation (CAUSTICS_MAP_UNKNOWN, _WATER or _DRY).
uint MapState(vec2 xz) {
    const uint v = world_map[MapIndex(xz)];
    return (v >> 2u) == Data(CAUSTICS_DATA_WORLD_GEN) ? (v & 3u) : CAUSTICS_MAP_UNKNOWN;
}

void MapSet(vec2 xz, uint state) {
    world_map[MapIndex(xz)] = (Data(CAUSTICS_DATA_WORLD_GEN) << 2u) | state;
}

// bbport (r130e_sewer-water-moves): the rippled reflection of a mirrored plane's water (see CAUSTICS_FLAG_WARP_COPY and _WARP).
// The pixel (centre, + 0.5) a view position projects to: ViewPos inverted.
vec2 PixelOf(vec3 v) {
    return (v.xy * proj.xy / max(v.z, 1e-4) + 1.0) * 0.5 * frame.xy + frame.zw;
}

// The game's water pixel at p: depth on the mirrored plane within the tolerance, up-facing, nearer than CAUSTICS_FADE_END (the water
// is drawn before this pass, so the plane test of the depth is its pixels). P, Pw: its view and world position.
bool WaterPixel(ivec2 p, out vec3 P, out vec3 Pw BED_DST_PARAM) {
    P = vec3(0.0);
    Pw = vec3(0.0);
    const float depth = texelFetch(depth_tex, p, 0).r;
#ifdef BB_BED_OBSERVER
    if (bed_destination) { BED_F(BED_OBS_DEPTH, depth) }
#endif
    if (depth >= 1.0) {
#ifdef BB_BED_OBSERVER
        if (bed_destination) { BED_U(BED_OBS_GATE, BED_GATE_CLEAR) }
#endif
        return false;
    }
    P = ViewPos(vec2(p) + 0.5, ViewZ(depth));
#ifdef BB_BED_OBSERVER
    if (bed_destination) { BED_F(BED_OBS_WATER_Z, P.z) }
#endif
    if (!(P.z < CAUSTICS_FADE_END)) {
#ifdef BB_BED_OBSERVER
        if (bed_destination) { BED_U(BED_OBS_GATE, BED_GATE_FADE) }
#endif
        return false;
    }
    Pw = ToWorld(P);
#ifdef BB_BED_OBSERVER
    if (bed_destination) { BED_RGB(BED_OBS_WATER_WORLD, Pw) }
#endif
    if (abs(Pw.y - sun.w) > CAUSTICS_WATER_M + CAUSTICS_WATER_REL * P.z) {
#ifdef BB_BED_OBSERVER
        if (bed_destination) { BED_U(BED_OBS_GATE, BED_GATE_DRY) }
#endif
        return false;
    }
#ifdef BB_BED_OBSERVER
    const float up = DirToWorld(NormalAt(p, P)).y;
    if (bed_destination) {
        BED_F(BED_OBS_NORMAL, up)
        BED_U(BED_OBS_GATE, up >= CAUSTICS_PUDDLE_UP ? BED_GATE_COPY_WET : BED_GATE_NORMAL)
    }
    return up >= CAUSTICS_PUDDLE_UP;
#else
    return DirToWorld(NormalAt(p, P)).y >= CAUSTICS_PUDDLE_UP;
#endif
}

// t133f: binding 4 is an independent result slice for this dispatch.
bool ProbeFinite(float x) {
    return !isnan(x) && !isinf(x);
}

bool ProbeFinite(vec3 v) {
    return !any(isnan(v)) && !any(isinf(v));
}

bool ProbeDepthValid(float raw) {
    return ProbeFinite(raw) && raw >= 0.0 && raw < 1.0 && raw < proj.z &&
           ProbeFinite(ViewZ(raw)) && ViewZ(raw) > 0.0;
}

uint ProbePoint(uint point, inout uint words[CAUSTICS_PROBE_POINT_WORDS]) {
    const vec2 offsets[4] = vec2[4](vec2(-1, 0), vec2(1, 0), vec2(0, -1), vec2(0, 1));
    const vec2 xz = sun.xz + offsets[point] * drift.z;
    const vec3 Q = vec3(xz.x, sun.w, xz.y);
    const vec3 V = ToView(Q);
    if (!ProbeFinite(V) || !(V.z > 0.05)) {
        return CAUSTICS_PROBE_PROJECTION;
    }
    const vec2 q = PixelOf(V);
    if (any(isnan(q)) || any(isinf(q))) {
        return CAUSTICS_PROBE_PROJECTION;
    }
    if (any(lessThan(q, vec2(0))) || any(greaterThanEqual(q, frame.xy))) {
        return CAUSTICS_PROBE_OFFSCREEN;
    }
    const ivec2 p = ivec2(q);
    words[4] = uint(p.x);
    words[5] = uint(p.y);
    if (any(lessThanEqual(p, ivec2(0))) || any(greaterThanEqual(p, ivec2(frame.xy) - 1))) {
        return CAUSTICS_PROBE_BORDER;
    }
    const vec2 centre = vec2(p) + 0.5;
    const vec3 ray = DirToWorld(ViewPos(centre, 1.0));
    const float expected_z = (sun.w - inv1.w) / ray.y;
    const vec3 Qc = ToWorld(ViewPos(centre, expected_z));
    if (!ProbeFinite(Qc) || !ProbeFinite(expected_z) || !(expected_z > 0.0)) {
        return CAUSTICS_PROBE_COARSE;
    }
    words[7] = floatBitsToUint(expected_z);
    if (!(distance(Qc, Q) <= drift.w)) {
        return CAUSTICS_PROBE_COARSE;
    }
    const float raw = texelFetch(depth_tex, p, 0).r;
    words[6] = floatBitsToUint(raw);
    if (raw == 1.0) {
        return CAUSTICS_PROBE_SKY;
    }
    if (!ProbeDepthValid(raw)) {
        return CAUSTICS_PROBE_DEPTH;
    }
    const vec3 P = ViewPos(centre, ViewZ(raw));
    const vec3 Pw = ToWorld(P);
    if (!ProbeFinite(Pw)) {
        return CAUSTICS_PROBE_DEPTH;
    }
    words[8] = floatBitsToUint(P.z);
    words[13] = floatBitsToUint(Pw.y - sun.w);
    words[14] = floatBitsToUint(distance(Pw.xz, Qc.xz));
    words[15] = floatBitsToUint(P.z - expected_z);
    if (!(distance(Pw, Qc) <= drift.w)) {
        return P.z < expected_z ? CAUSTICS_PROBE_OCCLUDED : CAUSTICS_PROBE_NO_SURFACE;
    }
    vec3 adjacent[4];
    for (uint i = 0; i < 4; ++i) {
        const ivec2 step = ivec2(offsets[i]);
        const float neighbour = texelFetch(depth_tex, p + step, 0).r;
        if (!ProbeDepthValid(neighbour)) {
            return CAUSTICS_PROBE_NEIGHBOUR;
        }
        adjacent[i] = ViewPos(centre + vec2(step), ViewZ(neighbour));
    }
    // Use the validated samples for the logged normal. WaterPixel still runs the
    // production NormalAt and predicate unchanged.
    const vec3 l = adjacent[0], r = adjacent[1], u = adjacent[2], d = adjacent[3];
    const vec3 dx = abs(r.z - P.z) < abs(P.z - l.z) ? r - P : P - l;
    const vec3 dy = abs(d.z - P.z) < abs(P.z - u.z) ? d - P : P - u;
    const vec3 cross_view = cross(dy, dx);
    const float len = length(cross_view);
    if (!ProbeFinite(len) || !(len > 1e-12)) {
        return CAUSTICS_PROBE_NORMAL;
    }
    const vec3 n = DirToWorld(dot(cross_view, P) > 0.0 ? -cross_view / len : cross_view / len);
    if (!ProbeFinite(n) || !(dot(n, n) > 1e-12)) {
        return CAUSTICS_PROBE_NORMAL;
    }
    words[9] = floatBitsToUint(Pw.x);
    words[10] = floatBitsToUint(Pw.y);
    words[11] = floatBitsToUint(Pw.z);
    words[12] = floatBitsToUint(n.y);
    vec3 tested_view, tested_world;
    return WaterPixel(p, tested_view, tested_world BED_DST_ARG(false)) ? CAUSTICS_PROBE_OK : CAUSTICS_PROBE_PREDICATE;
}

void ProbeWrite(uint point) {
    if (point == 0u) {
        counts[0] = CAUSTICS_PROBE_MAGIC;
        counts[1] = CAUSTICS_PROBE_VERSION;
        counts[2] = slot;
        counts[3] = floatBitsToUint(drift.x);
        counts[4] = floatBitsToUint(drift.y);
        counts[5] = CAUSTICS_PROBE_POINTS;
        counts[6] = CAUSTICS_PROBE_POINT_WORDS;
        counts[7] = 0u;
        for (uint i = 0; i < 4; ++i) {
            counts[8 + i] = floatBitsToUint(sun[i]);
        }
        counts[12] = floatBitsToUint(drift.z);
        counts[13] = floatBitsToUint(drift.w);
        counts[14] = 0u;
        counts[15] = 0u;
    }
    uint words[CAUSTICS_PROBE_POINT_WORDS];
    words[0] = slot;
    words[1] = point;
    words[4] = CAUSTICS_PROBE_INVALID_PIXEL;
    words[5] = CAUSTICS_PROBE_INVALID_PIXEL;
    for (uint i = 6; i < CAUSTICS_PROBE_POINT_WORDS; ++i) {
        words[i] = CAUSTICS_PROBE_INVALID_FLOAT;
    }
    const uint reason = ProbePoint(point, words);
    words[2] = reason == CAUSTICS_PROBE_OK ? CAUSTICS_PROBE_WATER :
               reason == CAUSTICS_PROBE_PREDICATE ? CAUSTICS_PROBE_REJECTED : CAUSTICS_PROBE_UNKNOWN;
    words[3] = reason;
    const uint base = CAUSTICS_PROBE_HEADER_WORDS + point * CAUSTICS_PROBE_POINT_WORDS;
    for (uint i = 0; i < CAUSTICS_PROBE_POINT_WORDS; ++i) {
        counts[base + i] = words[i];
    }
}

bool BedPosition(ivec2 p, out vec3 view_pos, out vec3 world_pos BED_POSITION_PARAM) {
    const ivec2 q = (flags & CAUSTICS_FLAG_BED_2X) != 0u ? 2 * p + ivec2(1) : p;
    const float raw = texelFetch(bed_tex, q, 0).r;
#ifdef BB_BED_OBSERVER
    if (bed_observer_row != 0u) {
        counts[bed_observer_row + BED_OBS_READS] |= 1u << bed_sample;
        if ((flags & CAUSTICS_FLAG_BED_2X) != 0u) {
            const uint row = (bed_observer_row - BED_OBS_BASE) / BED_OBS_WORDS;
            const uint tap = BED_OBS_TAPS + (row * BED_OBS_NTAPS + bed_sample) * BED_OBS_TAP_WORDS;
            counts[tap] = uint(q.x);
            counts[tap + 1u] = uint(q.y);
            counts[tap + 2u] = floatBitsToUint(raw);
        }
        if (bed_sample == 0u) { BED_F(BED_OBS_RAW, raw) }
    }
#endif
    if (!ProbeDepthValid(raw)) {
#ifdef BB_BED_OBSERVER
        if (bed_sample == 0u) { BED_U(BED_OBS_REASON, BED_CAUSE_CENTRE_RAW) }
#endif
        return false;
    }
    view_pos = ViewPos(vec2(p) + 0.5, ViewZ(raw));
    world_pos = ToWorld(view_pos);
#ifdef BB_BED_OBSERVER
    if (bed_sample == 0u) {
        BED_F(BED_OBS_BED_Z, view_pos.z)
        BED_RGB(BED_OBS_BED_WORLD, world_pos)
        return BED_TEST(ProbeFinite(world_pos), BED_OBS_REASON, BED_CAUSE_CENTRE_WORLD) &&
               BED_TEST(sun.w - world_pos.y > CAUSTICS_WATER_M + CAUSTICS_WATER_REL * view_pos.z,
                        BED_OBS_REASON, BED_CAUSE_CENTRE_ABOVE);
    }
#endif
    return ProbeFinite(world_pos) &&
           sun.w - world_pos.y > CAUSTICS_WATER_M + CAUSTICS_WATER_REL * view_pos.z;
}

// Called only for a visible wet destination with compatible native depth and albedo.
vec3 NativeBedLight(ivec2 p, float water_z, bool moving) {
    if (!(water_z > 0.0 && water_z < CAUSTICS_FADE_END)) {
        BED_U(BED_OBS_REASON, BED_CAUSE_WATER_Z)
        return vec3(0.0);
    }
    vec3 Bv, B;
    if (!BedPosition(p, Bv, B BED_POSITION_ARG(0u)) ||
        !BED_TEST(Bv.z > water_z && Bv.z < CAUSTICS_FADE_END, BED_OBS_REASON, BED_CAUSE_CENTRE_Z)) {
        return vec3(0.0);
    }
    const ivec2 px = p + ivec2(p.x + 1 < int(frame.x) ? 1 : -1, 0);
    const ivec2 py = p + ivec2(0, p.y + 1 < int(frame.y) ? 1 : -1);
    vec3 bxv, bx, byv, by;
    if (!BED_TEST(BedPosition(px, bxv, bx BED_POSITION_ARG(1u)), BED_OBS_REASON, BED_CAUSE_X) ||
        !BED_TEST(BedPosition(py, byv, by BED_POSITION_ARG(2u)), BED_OBS_REASON, BED_CAUSE_Y)) {
        return vec3(0.0);
    }
    const vec3 dx = bxv - Bv;
    const vec3 dy = byv - Bv;
    const float edge_limit = 0.08 + 0.02 * Bv.z;
    const vec3 cross_view = cross(dy, dx);
    const float normal2 = dot(cross_view, cross_view);
    if (!(BED_TEST(dot(dx, dx) < edge_limit * edge_limit, BED_OBS_REASON, BED_CAUSE_EDGE_X) &&
          BED_TEST(dot(dy, dy) < edge_limit * edge_limit, BED_OBS_REASON, BED_CAUSE_EDGE_Y) &&
          BED_TEST(normal2 > 1e-18, BED_OBS_REASON, BED_CAUSE_DEGENERATE))) {
        return vec3(0.0);
    }
    const float orient = dot(cross_view, Bv) > 0.0 ? -1.0 : 1.0;
    const vec3 normal = DirToWorld(cross_view * (orient * inversesqrt(normal2)));
    const uint count = min(Data(CAUSTICS_DATA_COUNT), uint(CAUSTICS_MAX_LAMPS));
    const float gain = uintBitsToFloat(Data(CAUSTICS_DATA_GAIN));
    vec3 lit = vec3(0.0);
    for (uint k = 0u; k < count; ++k) {
        const uint at = CAUSTICS_DATA_LAMPS + k * CAUSTICS_LAMP_WORDS;
        const vec3 L = uintBitsToFloat(uvec3(Data(at), Data(at + 1u), Data(at + 2u)));
        const float radius = uintBitsToFloat(Data(at + 3u));
        const vec3 d = L - B;
        const float d2 = dot(d, d);
        const float facing = dot(normal, d);
        if (!(BED_TEST(L.y > sun.w, BED_OBS_LAMPS + k, BED_LAMP_HEIGHT) &&
              BED_TEST(radius > 0.0, BED_OBS_LAMPS + k, BED_LAMP_RADIUS) &&
              BED_TEST(d2 < radius * radius, BED_OBS_LAMPS + k, BED_LAMP_RANGE) &&
              BED_TEST(d2 > 1e-6, BED_OBS_LAMPS + k, BED_LAMP_NEAR) &&
              BED_TEST(facing > 0.0, BED_OBS_LAMPS + k, BED_LAMP_INCIDENCE))) {
            continue;
        }
        vec3 X = B + d * ((sun.w - B.y) / d.y);
        X.y = sun.w;
        ivec2 qi;
        vec2 q;
#ifdef BB_BED_OBSERVER
        const int crossing = Water(X, qi, q);
        BED_U(BED_OBS_LAMPS + k, BED_LAMP_WATER_RESULT + uint(crossing))
        if (crossing != AT_WATER) {
#else
        if (Water(X, qi, q) != AT_WATER) {
#endif
            continue;
        }
        const float dl = sqrt(d2);
        // Freeze the pattern clock. Moving bed light uses only the active water wave block.
        const float focus = clamp(PatternAt(X.xz, 0.0, moving), 0.0, 3.0);
#ifdef BB_BED_OBSERVER
        if (moving && bed_observer_row >= BED_OBS_BASE && counts[BED_OBS_MOTION_SERIES] == 1u) {
            const uint row = (bed_observer_row - BED_OBS_BASE) / BED_OBS_WORDS;
            const uint wet = row - BED_OBS_WARP * BED_OBS_NPOINTS;
            if (wet < 2u) {
                const uint at_optic = BED_OBS_OPTICS + (wet * CAUSTICS_MAX_LAMPS + k) * BED_OBS_OPTIC_WORDS;
                counts[at_optic] = floatBitsToUint(X.x);
                counts[at_optic + 1u] = floatBitsToUint(X.y);
                counts[at_optic + 2u] = floatBitsToUint(X.z);
                counts[at_optic + 3u] = floatBitsToUint(focus);
            }
        }
#endif
        const float transmission = 1.0 - exp(-gain * CAUSTICS_BED_T * focus);
        const vec3 colour = uintBitsToFloat(uvec3(Data(at + 4u), Data(at + 5u), Data(at + 6u)));
        lit += colour * (LampCurve(dl / radius) * clamp(facing / dl, 0.0, 1.0) * transmission);
    }
    BED_RGB(BED_OBS_INCIDENT, lit)
    if (!(dot(lit, LUMA) > 0.0)) {
        BED_U(BED_OBS_REASON, BED_CAUSE_NO_INCIDENT)
        return vec3(0.0);
    }
    const vec3 albedo = texelFetch(albedo_tex, p, 0).rgb;
    const float fade = 1.0 - smoothstep(CAUSTICS_FADE_START, CAUSTICS_FADE_END, Bv.z);
#ifdef BB_BED_OBSERVER
    const float strength = uintBitsToFloat(Data(CAUSTICS_DATA_BED));
    const vec3 product = lit * albedo * (fade * strength);
    BED_RGB(BED_OBS_CB2, albedo)
    BED_F(BED_OBS_FADE, fade)
    BED_F(BED_OBS_STRENGTH, strength)
    BED_RGB(BED_OBS_NATIVE, product)
    BED_U(BED_OBS_REASON, dot(product, LUMA) > 0.0 ? BED_CAUSE_POSITIVE : BED_CAUSE_NO_PRODUCT)
    return product;
#else
    return lit * albedo * (fade * uintBitsToFloat(Data(CAUSTICS_DATA_BED)));
#endif
}

// One thread of the WARP_COPY or WARP dispatch: g is its place in the band (the band starts at the block's ROW0).
void WarpPixel(ivec2 g) {
    const int row0 = int(Motion(CAUSTICS_MOTION_ROW0));
    const ivec2 p = ivec2(g.x, g.y + row0);
    if (any(greaterThanEqual(p, ivec2(frame.xy)))) {
        return;
    }
#ifdef BB_BED_OBSERVER
    ObserveBedEnter(p, (flags & CAUSTICS_FLAG_WARP_COPY) != 0u ? BED_OBS_COPY : BED_OBS_WARP);
#endif
    vec3 P, Pw;
    if (!WaterPixel(p, P, Pw BED_DST_ARG(true))) {
        return;
    }
    const float stamp = float(Motion(CAUSTICS_MOTION_STAMP));
    BED_F(BED_OBS_STAMP, stamp)
    const vec4 s = imageLoad(scene_img, p);
    if ((flags & CAUSTICS_FLAG_WARP_COPY) != 0u) {
        BED_RGB(BED_OBS_RGB_BASE, s.rgb)
        BED_STORE(warp_img, p, vec4(s.rgb, stamp), BED_STORE_COPY)
        return;
    }
    // The mirror image moves by 2 x REFLECT_M x the slope (a tilt t turns the reflected ray by 2 t): project the point and the point
    // moved on the plane, the difference is the shift (faded out with distance, at most SHIFT_MAX x the frame's height).
    vec2 slope;
    const float lap = WaveAt(Pw.xz, slope);
    const float fade = 1.0 - smoothstep(CAUSTICS_FADE_START, CAUSTICS_FADE_END, P.z);
    const vec3 V2 = ToView(Pw + (2.0 * CAUSTICS_MOTION_REFLECT_M) * vec3(slope.x, 0.0, slope.y));
    vec2 shift = V2.z > 0.05 ? (PixelOf(V2) - PixelOf(P)) * fade : vec2(0.0);
    const float lim = CAUSTICS_MOTION_SHIFT_MAX * frame.y;
    const float len = length(shift);
    if (len > lim) {
        shift *= lim / len;
    }
    const bool ambient = (flags & CAUSTICS_FLAG_AMBIENT) != 0u;
    // Bilinear over the four copy texels that hold this dispatch's stamp.
    const vec2 q = vec2(p) + shift;
    const ivec2 q0 = ivec2(floor(q));
    const vec2 f = q - vec2(q0);
    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    for (int j = 0; j < 2; ++j) {
        for (int i = 0; i < 2; ++i) {
            const ivec2 t = q0 + ivec2(i, j);
            if (any(lessThan(t, ivec2(0))) || any(greaterThanEqual(t, ivec2(frame.xy)))) {
                continue;
            }
            if (ambient) {
                // A wrapped stamp cannot distinguish a texel this COPY did not write.
                vec3 donor_view, donor_world;
                if (t.y < row0 || !WaterPixel(t, donor_view, donor_world BED_DST_ARG(false))) {
                    continue;
                }
            }
            const vec4 c = imageLoad(warp_img, t);
            if (abs(c.a - stamp) > 0.25) {
                continue;
            }
            const float w = (i == 0 ? 1.0 - f.x : f.x) * (j == 0 ? 1.0 - f.y : f.y);
            sum += w * c.rgb;
            wsum += w;
        }
    }
    vec3 rgb = s.rgb;
    atomicAdd(group_warp[0], 1u);
    if (wsum >= 0.5) {
        rgb = sum / wsum;
    } else {
        atomicAdd(group_warp[1], 1u); // kept: the source is not water
    }
    const bool native_bed = (flags & (CAUSTICS_FLAG_NATIVE_BED | CAUSTICS_FLAG_ALBEDO)) ==
                            (CAUSTICS_FLAG_NATIVE_BED | CAUSTICS_FLAG_ALBEDO);
    BED_F(BED_OBS_DONOR, wsum)
    BED_U(BED_OBS_GATE, native_bed ? BED_GATE_NATIVE : BED_GATE_LEGACY)
    const vec3 bed = native_bed ? NativeBedLight(p, P.z, true) : vec3(0.0);
    const bool bed_lit = dot(bed, LUMA) > 0.0;
    if (ambient) {
        BED_RGB(BED_OBS_RGB_BASE, rgb)
        if (bed_lit) {
            BED_STORE(scene_img, p, vec4(rgb + bed, s.a), BED_STORE_SCENE)
        } else if (wsum >= 0.5) {
            BED_STORE(scene_img, p, vec4(rgb, s.a), BED_STORE_SCENE)
        }
        return;
    }
    // The glint: bright reflections sparkle, dark water does not; the focus has mean 1 (light moved, not added); it follows the knob.
    const float lum = dot(max(rgb, vec3(0.0)), LUMA);
    const float strength = uintBitsToFloat(Motion(CAUSTICS_MOTION_STRENGTH));
    const float t = clamp(CAUSTICS_MOTION_GLINT * strength * (Focus(lap) - 1.0) * (lum / (lum + CAUSTICS_MOTION_GLINT_KNEE)),
                          -CAUSTICS_MOTION_GLINT_MAX, CAUSTICS_MOTION_GLINT_MAX) * fade;
    rgb *= 1.0 + t;
    BED_RGB(BED_OBS_RGB_BASE, rgb)
    if (bed_lit) {
        rgb += bed;
    }
    BED_STORE(scene_img, p, vec4(rgb, s.a), BED_STORE_SCENE)
}

void Shade(ivec2 p) {
#ifdef BB_BED_OBSERVER
    ObserveBedEnter(p, BED_OBS_SHADE);
#endif
    const float depth = texelFetch(depth_tex, p, 0).r;
    BED_F(BED_OBS_DEPTH, depth)
    if (depth >= 1.0) {
        BED_U(BED_OBS_GATE, BED_GATE_CLEAR)
        return;
    }
    const vec3 P = ViewPos(vec2(p) + 0.5, ViewZ(depth));
    const vec3 Pw = ToWorld(P);
    BED_F(BED_OBS_WATER_Z, P.z)
    BED_RGB(BED_OBS_WATER_WORLD, Pw)
    const bool show = (flags & CAUSTICS_FLAG_SHOW) != 0u;
    float factor = 1.0;
    vec3 tint = vec3(0.0);
    float tint_k = 0.0;
    vec3 n = vec3(0.0);
    bool have_n = false;
    const bool puddle = (flags & CAUSTICS_FLAG_PUDDLE) != 0u; // r107e
    if (puddle) {
        // r107e: the puddle candidates by height under the camera; on the plane given (if any),
        // the up-facing pixels and the candidates among them.
        const bool wet =
            texelFetch(material_tex, TexelOf(material_tex, p, vec2(p) + 0.5), 0).r >= CAUSTICS_PUDDLE_GLOSS;
        const bool on_plane = (flags & CAUSTICS_FLAG_PUDDLE_PLANE) != 0u &&
                              abs(Pw.y - sun.w) <= CAUSTICS_WATER_M + CAUSTICS_WATER_REL * P.z;
        if (wet || on_plane) {
            n = NormalAt(p, P);
            have_n = true;
            if (DirToWorld(n).y >= CAUSTICS_PUDDLE_UP) {
                const int bin = int(floor((Pw.y - inv1.w + CAUSTICS_HEIGHT_RANGE) / CAUSTICS_HEIGHT_STEP));
                if (wet && bin >= 0 && bin < CAUSTICS_HEIGHT_BINS) {
                    atomicAdd(group_counts[CAUSTICS_W_HEIGHTS + bin], 1u);
                }
                if (on_plane) {
                    atomicAdd(group_counts[CAUSTICS_W_PUDDLE_GROUND], 1u);
                    if (wet) {
                        atomicAdd(group_counts[CAUSTICS_W_PUDDLE_WET], 1u);
                    }
                }
            }
        }
    }
    if (show && (flags & CAUSTICS_FLAG_MATERIAL) != 0u) {
        // Puddle candidates: surfaces facing up, by their gloss (0.5 none, 0.95 full).
        n = NormalAt(p, P);
        have_n = true;
        const float up = DirToWorld(n).y;
        const float gloss = texelFetch(material_tex, p, 0).r;
        const float k = smoothstep(0.5, 0.95, gloss) * smoothstep(0.85, 0.95, up);
        if (k > 0.0) {
            tint = TINT_PUDDLE;
            tint_k = 0.5 * k;
            atomicAdd(group_counts[3], 1u);
        }
    }
    const float height = Pw.y - sun.w;
    if ((flags & CAUSTICS_FLAG_PLANE) != 0u && height > CAUSTICS_MIN_HEIGHT &&
        height < CAUSTICS_MAX_HEIGHT) {
        // The sun's light reflected off the water travels along r (up: sun.y > 0, the host's test).
        const vec3 r = vec3(-sun.x, sun.y, -sun.z);
        if (!have_n) {
            n = NormalAt(p, P);
            have_n = true;
        }
        const float facing = dot(DirToWorld(n), -r);
        const float path = height / r.y;
        if (facing > CAUSTICS_MIN_FACING && path < CAUSTICS_MAX_PATH) {
            atomicAdd(group_counts[0], 1u);
            const vec3 Qw = Pw - r * path;
            ivec2 qi;
            vec2 q;
            const int at = Water(Qw, qi, q);
            if (at > AT_BELOW) {
                atomicAdd(group_counts[at == AT_OFF ? CAUSTICS_W_OFF
                                       : at == AT_HIDDEN ? CAUSTICS_W_HIDDEN
                                                         : CAUSTICS_W_DRY], 1u);
                if (show) {
                    tint = at == AT_DRY ? TINT_DRY : TINT_UNSEEN; // r107c
                    tint_k = 0.25;
                }
            } else {
                atomicAdd(group_counts[1], 1u);
                atomicAdd(group_counts[at == AT_WATER ? CAUSTICS_W_ON_PLANE : CAUSTICS_W_BELOW], 1u);
                // The light set at Q: its bit in the slot's sun mask (the host sets the flag only
                // with the mask and the target).
                const uint set = min(uint(texelFetch(records_tex, TexelOf(records_tex, qi, q), 0).a *
                                              255.0 + 0.5),
                                     255u);
                const bool sunny = (flags & CAUSTICS_FLAG_RECORDS) != 0u &&
                                   ((Data(set >> 5u) >> (set & 31u)) & 1u) != 0u;
                const float lit =
                    sunny ? clamp(texelFetch(shadow_tex, TexelOf(shadow_tex, qi, q), 0).a, 0.0, 1.0)
                          : 0.0;
                if (!sunny) {
                    atomicAdd(group_counts[CAUSTICS_W_NO_SUN_SET], 1u);
                }
                if (lit <= 0.01) {
                    if (show) {
                        tint = TINT_SHADE;
                        tint_k = 0.25;
                    }
                } else {
                    atomicAdd(group_counts[2], 1u);
                    const float w = facing * lit * exp(-path / CAUSTICS_PATH_FALLOFF) *
                                    (1.0 - smoothstep(CAUSTICS_FADE_START, CAUSTICS_FADE_END, P.z));
                    factor = max(1.0 + gain * w * (Pattern(Qw.xz, 1.0) - 1.0), 0.0);
                    if (show) {
                        tint = TINT_DRAWN;
                        tint_k = 0.5;
                    }
                }
            }
        }
    }
    // bbport (r107f_caustics-world-anchored): the world map and the light seen through the water. An
    // up-facing pixel on the plane (or up to CAUSTICS_MAP_LEDGE above it) writes what it is; a water
    // pixel gets the lamps' unshadowed light on a horizontal surface, as the bed's (a mirrored
    // plane) or as the ripple that moves its own lamp light (a puddle).
    const bool world = (flags & CAUSTICS_FLAG_WORLD) != 0u;
    BED_U(BED_OBS_GATE, world ? BED_GATE_HEIGHT : BED_GATE_NO_WORLD)
    vec3 bed_add = vec3(0.0); // light seen through a mirrored plane's water, added
    vec3 bed_lit = vec3(0.0); // a puddle pixel's own lamp light (modelled)
    float bed_c = 1.0;        // the ripple's pattern there (1: none)
    if (world && height > -(CAUSTICS_WATER_M + CAUSTICS_WATER_REL * P.z) && height < CAUSTICS_MAP_LEDGE) {
        if (!have_n) {
            n = NormalAt(p, P);
            have_n = true;
        }
        BED_U(BED_OBS_GATE, BED_GATE_NORMAL)
#ifdef BB_BED_OBSERVER
        const float up = DirToWorld(n).y;
        BED_F(BED_OBS_NORMAL, up)
        if (up >= CAUSTICS_PUDDLE_UP) {
#else
        if (DirToWorld(n).y >= CAUSTICS_PUDDLE_UP) {
#endif
            BED_U(BED_OBS_GATE, BED_GATE_DRY)
            const bool on_plane = height <= CAUSTICS_WATER_M + CAUSTICS_WATER_REL * P.z;
            bool wet = on_plane;
            if (on_plane && puddle) {
                wet = (flags & CAUSTICS_FLAG_MATERIAL) != 0u &&
                      texelFetch(material_tex, TexelOf(material_tex, p, vec2(p) + 0.5), 0).r >= CAUSTICS_PUDDLE_GLOSS;
            }
            if (wet) {
                MapSet(Pw.xz, CAUSTICS_MAP_WATER);
                atomicAdd(group_counts[CAUSTICS_W_MAP_WATER], 1u);
                if (!puddle && (flags & CAUSTICS_FLAG_NATIVE_BED) != 0u) {
                    if ((flags & CAUSTICS_FLAG_BED_IN_WARP) == 0u) {
                        BED_U(BED_OBS_GATE, BED_GATE_NATIVE)
                        bed_add = NativeBedLight(p, P.z, false);
                    }
#ifdef BB_BED_OBSERVER
                    else { BED_U(BED_OBS_GATE, BED_GATE_DEFERRED) }
#endif
                } else {
                    BED_U(BED_OBS_GATE, puddle ? BED_GATE_PUDDLE : BED_GATE_LEGACY)
                    const uint lamps_here = min(Data(CAUSTICS_DATA_COUNT), uint(CAUSTICS_MAX_LAMPS));
                    vec3 bed = vec3(0.0);
                    for (uint k = 0u; k < lamps_here; ++k) {
                        const uint at = CAUSTICS_DATA_LAMPS + k * CAUSTICS_LAMP_WORDS;
                        const vec3 L = uintBitsToFloat(uvec3(Data(at), Data(at + 1u), Data(at + 2u)));
                        const float reach = uintBitsToFloat(Data(at + 3u));
                        const vec3 colour = uintBitsToFloat(uvec3(Data(at + 4u), Data(at + 5u), Data(at + 6u)));
                        const vec3 d = L - Pw;
                        const float dl = length(d);
                        if (dl < reach && dl > 1e-3) {
                            bed += colour * (LampCurve(dl / reach) * max(d.y / dl, 0.0));
                        }
                    }
                    const vec3 bed_albedo =
                        (flags & CAUSTICS_FLAG_ALBEDO) != 0u
                            ? texelFetch(albedo_tex, TexelOf(albedo_tex, p, vec2(p) + 0.5), 0).rgb
                            : vec3(0.5);
                    const float bed_fade = 1.0 - smoothstep(CAUSTICS_FADE_START, CAUSTICS_FADE_END, P.z);
                    if (puddle) {
                        bed_lit = bed * bed_albedo * bed_fade;
                        bed_c = clamp(mix(1.0, Pattern(Pw.xz, CAUSTICS_RIPPLE_SPEED), CAUSTICS_RIPPLE_CONTRAST), 0.0, 3.0);
                    } else {
                        bed_add = bed * bed_albedo *
                                  (CAUSTICS_BED_T * uintBitsToFloat(Data(CAUSTICS_DATA_BED)) * bed_fade *
                                   Pattern(Pw.xz, 1.0));
                    }
                }
            } else if (MapState(Pw.xz) != CAUSTICS_MAP_WATER) {
                MapSet(Pw.xz, CAUSTICS_MAP_DRY);
                atomicAdd(group_counts[CAUSTICS_W_MAP_DRY], 1u);
            }
        }
    }
    // bbport (r130b_water-moves): the surface shimmer. A water pixel (up-facing, on the mirrored plane within the tolerance, or a
    // glossy one on the checked puddle plane) closer than CAUSTICS_FADE_END has its own light times 1 + SHIMMER x strength x the
    // wave field's slope toward the camera (clamped, mean 1, faded out with distance). Not a true re-reflection: the tilt
    // brightens or darkens the light the pixel has. The host sets the plane's kind (0 none, 1 mirrored, 2 puddle plane).
    if ((flags & CAUSTICS_FLAG_MOTION) != 0u) {
        const uint mo_kind = Motion(CAUSTICS_MOTION_KIND);
        if (mo_kind != 0u && P.z < CAUSTICS_FADE_END && abs(height) <= CAUSTICS_WATER_M + CAUSTICS_WATER_REL * P.z &&
            (mo_kind == 1u ||
             ((flags & CAUSTICS_FLAG_MATERIAL) != 0u &&
              texelFetch(material_tex, TexelOf(material_tex, p, vec2(p) + 0.5), 0).r >= CAUSTICS_PUDDLE_GLOSS))) {
            if (!have_n) {
                n = NormalAt(p, P);
                have_n = true;
            }
            const vec2 mo_to_camera = vec2(inv0.w, inv2.w) - Pw.xz;
            const float mo_len = length(mo_to_camera);
            if (DirToWorld(n).y >= CAUSTICS_PUDDLE_UP && mo_len > 1e-3) {
                vec2 mo_slope;
                WaveAt(Pw.xz, mo_slope);
                const float mo_tilt = clamp(dot(mo_slope, mo_to_camera / mo_len) * 8.0, -0.6, 0.6) *
                                      (1.0 - smoothstep(CAUSTICS_FADE_START, CAUSTICS_FADE_END, P.z));
                factor *= 1.0 + CAUSTICS_MOTION_SHIMMER * uintBitsToFloat(Motion(CAUSTICS_MOTION_STRENGTH)) * mo_tilt;
                atomicAdd(group_counts[CAUSTICS_W_MOTION_WATER], 1u);
                if (ring_hit) {
                    atomicAdd(group_ring, 1u);
                }
            }
        }
    }
    vec3 added = vec3(0.0), direct = vec3(0.0); // r107c: direct, the lamps' own light (the model)
    if ((flags & CAUSTICS_FLAG_LAMPS) != 0u && height > CAUSTICS_MIN_HEIGHT &&
        height < CAUSTICS_LAMP_MAX_HEIGHT) {
        if (!have_n) {
            n = NormalAt(p, P);
        }
        const vec3 nw = DirToWorld(n);
        const uint lamps = min(Data(CAUSTICS_DATA_COUNT), uint(CAUSTICS_MAX_LAMPS));
        bool tried = false, dry = false, unseen = false;
        const float lamp_gain = uintBitsToFloat(Data(CAUSTICS_DATA_GAIN)); // r107c
        const float look = uintBitsToFloat(Data(CAUSTICS_DATA_LOOK));     // r107d
        float look_w = 0.0, look_c = 0.0;
        for (uint k = 0u; k < lamps; ++k) {
            const uint at = CAUSTICS_DATA_LAMPS + k * CAUSTICS_LAMP_WORDS;
            const vec3 L = uintBitsToFloat(uvec3(Data(at), Data(at + 1u), Data(at + 2u)));
            const float reach = uintBitsToFloat(Data(at + 3u));
            const vec3 colour = uintBitsToFloat(uvec3(Data(at + 4u), Data(at + 5u), Data(at + 6u)));
            // r107c: the lamp's own direct light here (no shadow), for the log's model.
            const float dl = length(L - Pw);
            if (!(dl < reach)) {
                continue; // the reflected path is longer still
            }
            direct += colour * (LampCurve(dl / reach) * max(dot(nw, L - Pw) / max(dl, 1e-4), 0.0));
            const float lamp_height = L.y - sun.w; // above the plane (the host's test)
            // The lamp mirrored in the plane: the water's light comes from there.
            const vec3 to_image = vec3(L.x, sun.w - lamp_height, L.z) - Pw;
            const float d = length(to_image);
            if (!(d < reach)) {
                continue;
            }
            const float facing = dot(nw, to_image) / d;
            if (facing <= CAUSTICS_MIN_FACING) {
                continue;
            }
            tried = true;
            // Where the path crosses the plane: lamp_height / (lamp_height + height) of the way
            // from the mirrored lamp to P.
            const vec3 X = Pw + to_image * (height / (lamp_height + height));
            ivec2 xi;
            vec2 xq;
            int crossing = Water(X, xi, xq);
            bool mapped = false; // r107f
            if (world && (crossing == AT_OFF || crossing == AT_HIDDEN)) {
                // r107f: the screen cannot see this crossing: the world map says what it was.
                const uint known = MapState(X.xz);
                if (known != CAUSTICS_MAP_UNKNOWN) {
                    atomicAdd(group_counts[known == CAUSTICS_MAP_WATER ? CAUSTICS_W_MAP_RESCUED_WATER
                                                                         : CAUSTICS_W_MAP_RESCUED_DRY], 1u);
                    crossing = known == CAUSTICS_MAP_WATER ? AT_WATER : AT_DRY;
                    mapped = true;
                }
            }
            if (puddle && crossing <= AT_BELOW && !mapped) {
                // r107e: on a puddle only: on the plane and a candidate there (else dry ground)
                crossing = crossing == AT_WATER && PuddleAt(xi) ? AT_WATER : AT_DRY;
            }
            if (crossing > AT_BELOW) {
                atomicAdd(group_counts[crossing == AT_DRY ? CAUSTICS_W_LAMP_DRY : CAUSTICS_W_LAMP_UNSEEN], 1u);
                dry = dry || crossing == AT_DRY;
                unseen = unseen || crossing != AT_DRY;
                if (!(look > 0.0 && crossing == AT_HIDDEN && !puddle)) { // r107e: not on puddles
                    continue;
                }
            }
            // r107e: a puddle's still water: slower, with less contrast.
            // r107f: with the world map puddles ripple like water.
            const float pattern =
                puddle ? (world ? mix(1.0, Pattern(X.xz, CAUSTICS_RIPPLE_SPEED), CAUSTICS_RIPPLE_CONTRAST)
                                : mix(1.0, Pattern(X.xz, CAUSTICS_PUDDLE_SPEED), CAUSTICS_PUDDLE_CONTRAST))
                       : Pattern(X.xz, 1.0);
            if (look > 0.0) {
                // r107d: the look's weight and the pattern's contrast of this lamp's crossing.
                const float w = facing * exp(-length(X - Pw) / CAUSTICS_PATH_FALLOFF);
                look_w += w;
                look_c += w * (1.0 - exp(-CAUSTICS_LAMP_GAIN * CAUSTICS_WATER_F0 * pattern));
            }
            if (crossing > AT_BELOW) {
                continue; // hidden: the look only
            }
            // The cosine of the path's angle to the plane's normal at X: the real incidence.
            const float cosine = (lamp_height + height) / d;
            const float reflectance =
                CAUSTICS_WATER_F0 + (1.0 - CAUSTICS_WATER_F0) * pow(1.0 - clamp(cosine, 0.0, 1.0), 5.0);
            // r107c: the lamp's own light at d and this facing, times the water's share (below 1).
            added += colour * (LampCurve(d / reach) * facing *
                               (1.0 - exp(-lamp_gain * reflectance * pattern)));
        }
        if (look_w > 0.0) {
            // r107d: all the light here, moved by the pattern (mean 1, capped by its range).
            factor *= 1.0 + look * min(look_w, 1.0) *
                                (1.0 - smoothstep(CAUSTICS_FADE_START, CAUSTICS_FADE_END, P.z)) *
                                (look_c / (look_w * CAUSTICS_LOOK_MEAN) - 1.0);
            atomicAdd(group_counts[CAUSTICS_W_LOOK], 1u);
        }
        if (tried) {
            atomicAdd(group_counts[CAUSTICS_W_LAMP_TRIED], 1u);
        }
        const vec3 albedo =
            (flags & CAUSTICS_FLAG_ALBEDO) != 0u ? texelFetch(albedo_tex, TexelOf(albedo_tex, p, vec2(p) + 0.5), 0).rgb
                                                 : vec3(0.5);
        added *= albedo * (1.0 - smoothstep(CAUSTICS_FADE_START, CAUSTICS_FADE_END, P.z));
        direct *= albedo; // r107c
        if (dot(added, LUMA) > 0.0) {
            atomicAdd(group_counts[CAUSTICS_W_LAMP_LIT], 1u);
            if (show) {
                tint = TINT_LAMP;
                tint_k = 0.5;
            }
        } else {
            added = vec3(0.0);
            if (show && (dry || unseen) && tint_k <= 0.0) {
                // a lamp's light reaches it, but not across water: dry ground orange, else grey (r107c)
                tint = dry ? TINT_DRY : TINT_UNSEEN;
                tint_k = 0.25;
            }
        }
    }
    const bool measure = dot(direct, LUMA) > 0.0; // r107d: the bins
    const bool bed_on = dot(bed_add, LUMA) > 0.0 || bed_c != 1.0; // r107f
    if (factor == 1.0 && tint_k <= 0.0 && !(dot(added, LUMA) > 0.0) && !measure && !bed_on) {
        return;
    }
    const vec4 s = imageLoad(scene_img, p);
    if (measure) {
        const float model = dot(direct, LUMA);
        const int bin = clamp(int(floor(0.5 * log2(model))) + 6, 0, CAUSTICS_BINS - 1);
        atomicAdd(group_counts[CAUSTICS_W_BIN_COUNT + bin], 1u);
        atomicAdd(group_counts[CAUSTICS_W_BIN_RATIO + bin],
                  uint(min(model / max(dot(max(s.rgb, vec3(0.0)), LUMA), 1e-4), CAUSTICS_MODEL_MAX) *
                           CAUSTICS_MODEL_SCALE + 0.5));
        if (factor == 1.0 && tint_k <= 0.0 && !(dot(added, LUMA) > 0.0) && !bed_on) {
            return;
        }
    }
    vec3 rgb = s.rgb * factor;
    if (dot(added, LUMA) > 0.0) {
        const float own = max(dot(max(rgb, vec3(0.0)), LUMA), 1e-4);
        atomicAdd(group_counts[CAUSTICS_W_LAMP_RATIO],
                  uint(min(dot(added, LUMA) / own, CAUSTICS_RATIO_MAX) * CAUSTICS_RATIO_SCALE + 0.5));
        atomicAdd(group_counts[CAUSTICS_W_LAMP_MODEL],
                  uint(min(dot(direct, LUMA) / own, CAUSTICS_MODEL_MAX) * CAUSTICS_MODEL_SCALE + 0.5));
        rgb += added;
    }
    if (bed_c != 1.0) {
        // r107f: a puddle's own lamp light moved by the ripple (its share of the pixel's light).
        const float own_bed = max(dot(max(rgb, vec3(0.0)), LUMA), 1e-4);
        rgb *= 1.0 + CAUSTICS_BED_PUDDLE * clamp(dot(bed_lit, LUMA) / own_bed, 0.0, 1.0) * (bed_c - 1.0);
        atomicAdd(group_counts[CAUSTICS_W_BED_PUDDLE], 1u);
    }
#ifdef BB_BED_OBSERVER
    const bool is_native = (flags & CAUSTICS_FLAG_NATIVE_BED) != 0u;
    if (is_native) { BED_RGB(BED_OBS_RGB_BASE, rgb) }
#endif
    if (dot(bed_add, LUMA) > 0.0) {
        rgb += bed_add; // r107f: the lamps' light on the bed under a mirrored plane's water
        atomicAdd(group_counts[CAUSTICS_W_BED], 1u);
    }
    if (tint_k > 0.0) {
        rgb = Tinted(rgb, tint, tint_k);
    }
#ifdef BB_BED_OBSERVER
    if (!is_native) { BED_RGB(BED_OBS_RGB_BASE, rgb) }
#endif
    BED_STORE(scene_img, p, vec4(rgb, s.a), BED_STORE_SCENE)
}

void main() {
    if ((flags & CAUSTICS_FLAG_WETNESS_PROBE) != 0u) {
        if (gl_LocalInvocationIndex < CAUSTICS_PROBE_POINTS) {
            ProbeWrite(gl_LocalInvocationIndex);
        }
        return;
    }
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    const bool in_bounds = all(lessThan(p, ivec2(frame.xy)));

    // r132g: dispatch-uniform flags keep copy and warp out of the ordinary caustics counters.
    if ((flags & CAUSTICS_FLAG_WARP_COPY) != 0u) {
        if (in_bounds) {
            WarpPixel(p);
        }
        return;
    }
    if ((flags & CAUSTICS_FLAG_WARP) != 0u) {
        if (gl_LocalInvocationIndex == 0u) {
            group_warp[0] = 0u;
            group_warp[1] = 0u;
        }
        barrier();
        if (in_bounds) {
            WarpPixel(p);
        }
        // Out-of-bounds invocations in an edge workgroup reach both barriers.
        barrier();
        if (gl_LocalInvocationIndex == 0u && (group_warp[0] | group_warp[1]) != 0u) {
            // r130e: the water pixels the warp took a colour for and those it kept, to the slot's motion block
            atomicAdd(counts[CAUSTICS_MOTION_BASE + slot * CAUSTICS_MOTION_WORDS + CAUSTICS_MOTION_WARP_PX], group_warp[0]);
            atomicAdd(counts[CAUSTICS_MOTION_BASE + slot * CAUSTICS_MOTION_WORDS + CAUSTICS_MOTION_WARP_KEPT], group_warp[1]);
        }
        return;
    }

    // r107e: more words than threads: each thread clears and adds every 64th.
    for (uint i = gl_LocalInvocationIndex; i < CAUSTICS_SLOT_WORDS; i += CAUSTICS_GROUP * CAUSTICS_GROUP) {
        group_counts[i] = 0u;
    }
    if ((flags & CAUSTICS_FLAG_MOTION) != 0u && gl_LocalInvocationIndex == 0u) {
        group_ring = 0u; // r130b
    }
    barrier();
    if (in_bounds) {
        Shade(p);
    }
    barrier();
    for (uint i = gl_LocalInvocationIndex; i < CAUSTICS_SLOT_WORDS; i += CAUSTICS_GROUP * CAUSTICS_GROUP) {
        const uint v = group_counts[i];
        if (v != 0u) {
            atomicAdd(counts[slot * CAUSTICS_SLOT_WORDS + i], v);
        }
    }
    if ((flags & CAUSTICS_FLAG_MOTION) != 0u && gl_LocalInvocationIndex == 0u && group_ring != 0u) {
        // r130b: the water pixels a ring reached, to the slot's motion block (the host reads it before it rewrites the slot)
        atomicAdd(counts[CAUSTICS_MOTION_BASE + slot * CAUSTICS_MOTION_WORDS + CAUSTICS_MOTION_RING_PX], group_ring);
    }
}
