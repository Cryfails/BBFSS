#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT retained_scene;
layout(set = 0, binding = 1) uniform accelerationStructureEXT current_scene;
layout(set = 0, binding = 2) uniform texture2D depth_tex;
layout(set = 0, binding = 3) uniform texture2D cb0_tex;

struct Hit {
    uvec4 ids;
    vec4 distance;
    vec4 world;
};
struct Sample {
    uvec4 info;
    uvec4 cb0_bytes;
    vec4 native_point_depth;
    vec4 origin_t;
    vec4 direction_depth_delta;
    Hit receiver;
    Hit world[2];
    Hit farther[2];
};
layout(set = 0, binding = 4, std430) buffer RequestBuffer {
    uvec4 pixels[8];
    uvec4 tags[2];
    uvec4 echoed[2];
    Sample samples[8];
} records;

layout(set = 0, binding = 5, std430) readonly buffer PlacedPalettes {
    uint reference[3][24];
    uint observed[3][24];
} palettes;

layout(push_constant) uniform Params {
    vec4 view0;
    vec4 view1;
    vec4 view2;
    vec4 projection;
    vec4 plane_normal;
    vec2 jitter;
    uvec2 extent;
    uint count;
    uint placed_mask;
} pc;

const uint InvalidId = 0xffffffffu;
const uint ReceiverMask = 1u;
const uint WorldMask = 2u;
const uint WallMask = 4u;
const uint Planar = 1u;
const uint Direct = 2u;
const uint Sampled = 1u;
const uint InvalidDepth = 2u;
const uint OutsideReceiver = 3u;
const uint DepthMismatch = 4u;
const uint InvalidNormal = 5u;
const uint InvalidPlacement = 6u;
const float Minimum = 0.001;
const float Limit = 16.0;
const Hit Miss = Hit(uvec4(InvalidId, InvalidId, InvalidId, 0), vec4(0), vec4(0));

bool finite3(vec3 v) {
    return !any(isnan(v)) && !any(isinf(v));
}

vec3 world(vec3 p) {
    vec3 v = p - vec3(pc.view0.w, pc.view1.w, pc.view2.w);
    return pc.view0.xyz * v.x + pc.view1.xyz * v.y + pc.view2.xyz * v.z;
}

Hit trace(accelerationStructureEXT scene, uint mask, vec3 origin, vec3 direction,
          float minimum, float limit) {
    rayQueryEXT ray;
    rayQueryInitializeEXT(ray, scene, gl_RayFlagsOpaqueEXT, mask, origin, minimum, direction, limit);
    while (rayQueryProceedEXT(ray)) {}
    if (rayQueryGetIntersectionTypeEXT(ray, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
        return Miss;
    }
    float t = rayQueryGetIntersectionTEXT(ray, true);
    vec3 p = origin + t * direction;
    return Hit(uvec4(rayQueryGetIntersectionInstanceCustomIndexEXT(ray, true),
                     rayQueryGetIntersectionPrimitiveIndexEXT(ray, true),
                     rayQueryGetIntersectionGeometryIndexEXT(ray, true), 0),
               vec4(t, rayQueryGetIntersectionBarycentricsEXT(ray, true),
                    dot(pc.view2.xyz, p) + pc.view2.w),
               vec4(p, 0));
}

Hit trace_farther(accelerationStructureEXT scene, vec3 origin, vec3 direction, Hit first) {
    float minimum = first.distance.x + 0.0001;
    if (first.ids.x == InvalidId || minimum >= Limit) {
        return Miss;
    }
    return trace(scene, WorldMask, origin, direction, minimum, Limit);
}

Sample measure(uvec4 pixel, bool invalid_placement) {
    Sample s;
    s.info = uvec4(InvalidDepth, pixel.xyz);
    s.cb0_bytes = uvec4(0);
    s.native_point_depth = vec4(0);
    s.origin_t = vec4(0);
    s.direction_depth_delta = vec4(0);
    s.receiver = Miss;
    s.world = Hit[2](Miss, Miss);
    s.farther = Hit[2](Miss, Miss);
    if (invalid_placement) {
        s.info.x = InvalidPlacement;
        return s;
    }

    // Same native pixel centre, signed projection and UNORM cb0 as bottle_caustic::surface.
    ivec2 p = ivec2(pixel.xy);
    float d = texelFetch(depth_tex, p, 0).x;
    vec4 cb0 = texelFetch(cb0_tex, p, 0);
    s.cb0_bytes = uvec4(round(clamp(cb0, 0, 1) * 255.0));
    s.native_point_depth.w = d;
    float z = pc.projection.w / (d - pc.projection.z);
    if (!(d > 0.0 && d < 1.0 && z > 0.0) || isinf(z)) {
        return s;
    }
    vec2 ndc = (vec2(p) + 0.5 - pc.jitter) / vec2(pc.extent) * 2.0 - 1.0;
    vec3 camera = world(vec3(0));
    vec3 native_point = world(vec3(ndc * z / pc.projection.xy, z));
    vec3 incident = native_point - camera;
    float native_range = length(incident);
    if (!finite3(native_point) || !(native_range > Minimum) || isinf(native_range)) {
        return s;
    }
    s.native_point_depth.xyz = native_point;
    incident /= native_range;

    vec3 origin = camera;
    vec3 direction = incident;
    if (pixel.z != Direct) {
        // The receiver-only instance is the actual finite eight-triangle world BLAS.
        s.receiver = trace(retained_scene, ReceiverMask, camera, incident, Minimum, Limit);
        if (s.receiver.ids.x == InvalidId) {
            s.info.x = OutsideReceiver;
            return s;
        }
        origin = s.receiver.world.xyz;
        s.origin_t = vec4(origin, s.receiver.distance.x);
        s.direction_depth_delta.w = native_range - s.receiver.distance.x;
        if (abs(s.direction_depth_delta.w) > 0.002 || length(native_point - origin) > 0.002) {
            s.info.x = DepthMismatch;
            return s;
        }
        vec3 normal = pixel.z == Planar ? pc.plane_normal.xyz : cb0.xyz * 2.0 - 1.0;
        float len2 = dot(normal, normal);
        if (!finite3(normal) || !(len2 >= 0.25) || isinf(len2)) {
            s.info.x = InvalidNormal;
            return s;
        }
        normal *= inversesqrt(len2);
        normal = faceforward(normal, incident, normal);
        direction = normalize(reflect(incident, normal));
    }

    s.info.x = Sampled;
    s.origin_t.xyz = origin;
    s.direction_depth_delta.xyz = direction;
    s.world[0] = trace(retained_scene, WorldMask, origin, direction, Minimum, Limit);
    s.world[1] = trace(current_scene, WorldMask, origin, direction, Minimum, Limit);
    if (pixel.w == 1u) {
        s.farther[0] = trace_farther(retained_scene, origin, direction, s.world[0]);
        s.farther[1] = trace_farther(current_scene, origin, direction, s.world[1]);
    } else if (pixel.w == 2u) {
        s.farther[0] = trace(retained_scene, WallMask, origin, direction, Minimum, Limit);
        s.farther[1] = trace(current_scene, WallMask, origin, direction, Minimum, Limit);
    }
    return s;
}

shared uint palette_mismatch;

void main() {
    uint i = gl_LocalInvocationID.x;
    bool invalid_placement = false;
    if (pc.placed_mask != 0u) {
        if (i == 0u) {
            palette_mismatch = 0u;
        }
        barrier();
        for (uint source = 0u; source < 3u; ++source) {
            if ((pc.placed_mask & (1u << source)) != 0u) {
                uint difference = 0u;
                for (uint word = i; word < 24u; word += 8u) {
                    difference |= palettes.reference[source][word] ^ palettes.observed[source][word];
                }
                if (difference != 0u) {
                    atomicOr(palette_mismatch, 1u << source);
                }
            }
        }
        barrier();
        // A changed source could occlude a different first hit. Suppress both arms.
        invalid_placement = palette_mismatch != 0u;
    }
    if (i == 0u) {
        records.echoed[0] = records.tags[0];
        records.echoed[1] = records.tags[1];
    }
    if (i < pc.count) {
        records.samples[i] = measure(records.pixels[i], invalid_placement);
    }
}
