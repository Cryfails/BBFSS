// Called once a workgroup has a tile (an empty one reads nothing).
void loadTune() {
    if ((mode & MODE_REPAIR) == 0u) {
        return;
    }
    const uint at = mode >> 8u;
    const uint f = data.d[at];
    new_w = (f & 1u) != 0u;
    inv_sq = (f & 2u) != 0u;
    t_view = (f >> 8u) & 7u;
    t_follow_soft = (f & (1u << 20u)) != 0u; // bbport (r52_follow-soft); bits 12-17: r63's cap below
    t_window = (f & (1u << 21u)) != 0u;      // bbport (r57_lamp-window)
#ifdef COLOUR
    t_colour = (f & (1u << 25u)) != 0u;      // bbport (r92_lamp-shadow-colour)
#endif
#ifdef CENTRED
    t_centred = (f & (1u << 22u)) != 0u;     // bbport (r60_lamp-centred-window)
    t_young = (f & (1u << 27u)) != 0u;       // bbport (r103_lamp-young-pixels)
    t_young_keep = (f & (1u << 28u)) != 0u;  // bbport (r103_lamp-young-pixels)
    t_young_still = (f & (1u << 29u)) != 0u; // bbport (r103b_lamp-young-standing)
    t_spatial = (f & (1u << 26u)) != 0u;     // bbport (r93_lamp-shadow-spatial)
#endif
#ifdef CARDS
    // bbport (r63_leaf-stage4): BB_RT_CARD_LAMP_CAP (vk_point_shadow.cpp Flush sets bits 12-17 for a
    // pass that binds this build; LampTuneWords leaves them 0, the default)
    const uint card_cap = (f >> 12u) & 63u;
    t_card_cap = card_cap == 0u ? CARD_RAY_CAP_DEFAULT : min(card_cap, CARD_RAY_CAP_MOST);
#endif
    t_clear = word(at + 1u);
    t_radius = word(at + 2u);
    t_disc_each = (f & (1u << 24u)) != 0u; // bbport (r91_lamp-radius-per-lamp)
    t_halo = float((f >> 4u) & 7u) * (1.0 / 8.0);     // bbport (r114_lamp-shadow-layers)
    t_halo_wide = 2.0 + 0.5 * float((f >> 18u) & 3u); // bbport (r114_lamp-shadow-layers)
    t_halo_core = 1.0 - 0.25 * float(f >> 30u);       // bbport (r114_lamp-shadow-layers)
    t_layers_two = (f & (1u << 7u)) != 0u;            // bbport (r114_lamp-shadow-layers)
#ifndef RESOLVE
    t_flame = ((f >> 11u) & 1u) * (1u + ((f >> 23u) & 1u)); // bbport (r113_lamp-softness)
#endif
    t_frame = data.d[at + 3u];
    t_self = word(at + 4u);
    t_wrap = word(at + 5u);
    t_core2 = word(at + 6u);
    t_gain = word(at + 7u);
    t_floor = word(at + 8u);
    t_reject = word(at + 9u);
    t_axis_a = vec3(word(at + 10u), word(at + 11u), word(at + 12u));
    t_axis_b = vec3(word(at + 13u), word(at + 14u), word(at + 15u));
}

// The views' colour for a count: 0 blue, 1 green, 2 yellow, 3 or more red.
vec3 stepColour(uint k) {
    return k == 0u ? vec3(0.0, 0.0, 1.0)
                   : k == 1u ? vec3(0.0, 1.0, 0.0) : k == 2u ? vec3(1.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
}

// A lamp's weight in the pixel's shadow ratio: about its share of the lamps' light there.
// to_light: from the surface to the lamp; t2: its length squared over the radius squared.
// Before (and with BB_LAMP_SHADOW_WEIGHTS=0): (1 - t2)^2 * luma. The game's own curve is
// (1 - d/r)^2 (vk_local_falloff.h), or 1 / (t2 + core^2) - 1 / (1 + core^2) with
// startup_local_inverse_square, and its light goes with N.L: the old weight overrated a lamp far
// away or behind the surface, so that lamp's shadow took the nearer lamp's light and the nearer
// lamp's shadow took too little. The normal is the one from depth: t_wrap forgives its error,
// and the facing never falls below t_floor: it ranks the lamps, it does not remove one. (A pixel
// whose only lamp had no weight would get no ray and keep that lamp's light unshadowed, also
// inside a wall's shadow; and the normal is arbitrary on features a pixel or two wide.) With the
// floor a lamp behind the surface keeps a ray, which its own surface blocks, as before.
float lampWeight(vec3 to_light, float t2, vec3 col, vec3 n) {
    const float l = dot(col, vec3(0.299, 0.587, 0.114));
    if (!new_w) {
        float w = 1.0 - t2;
        w *= w * l;
        return w;
    }
    float f = 1.0 - sqrt(t2);
    f *= f;
    if (inv_sq) {
        f = max(0.0, 1.0 / max(t2 + t_core2, 1e-6) - 1.0 / (1.0 + t_core2));
    }
    float facing = 1.0;
    if (t_wrap < 1.0 && n != vec3(0.0)) {
        facing = clamp((dot(n, to_light) * inversesqrt(max(dot(to_light, to_light), 1e-8)) + t_wrap) /
                           (1.0 + t_wrap),
                       t_floor, 1.0);
    }
    return f * facing * l;
}

vec3 viewPosAt(vec2 uv, float depth) {
    vec4 v = shared_inverse * vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    return v.xyz / v.w;
}

vec3 surfaceNormal(vec2 uv, vec3 P) {
    const vec2 px = 1.0 / size;
    vec3 best[2];
    for (int axis = 0; axis < 2; ++axis) {
        const vec2 step_uv = axis == 0 ? vec2(px.x, 0.0) : vec2(0.0, px.y);
        const vec3 a = viewPosAt(uv + step_uv, textureLod(depth_tex, uv + step_uv, 0.0).x) - P;
        const vec3 b = P - viewPosAt(uv - step_uv, textureLod(depth_tex, uv - step_uv, 0.0).x);
        best[axis] = abs(a.z) < abs(b.z) ? a : b;
    }
    vec3 n = cross(best[1], best[0]);
    const float len = length(n);
    if (!(len > 1e-12)) {
        return vec3(0.0);
    }
    n /= len;
    return dot(n, P) > 0.0 ? -n : n;
}

#ifdef CARDS
// bbport (r63_leaf-stage4): the angle a pixel spans at the screen's centre (radians, near enough
// for a level of detail), worked out once an invocation. A lamp ray's footprint is a pixel at its
// start (its distance from the camera times this) and narrows to nothing at the lamp, so a leaf
// near the lamp is read at a finer level than one near the surface. Not finite (a matrix that is
// no projection): 0, level 0. Times CARD_TEXEL_SCALE (BB_RT_CARD_LAMP_TEXELS: the layer texels a
// metre of card are a guess).
float card_px = -1.0;
float cardPixelAngle() {
    if (card_px < 0.0) {
        const vec3 a = viewPosAt(vec2(0.5), 0.5);
        const vec3 b = viewPosAt(vec2(0.5 + 1.0 / size.x, 0.5), 0.5);
        const float angle = length(b - a) / length(a) * CARD_TEXEL_SCALE;
        card_px = angle >= 0.0 && !isinf(angle) ? angle : 0.0;
        card_px *= CARD_LEVEL_SCALE; // bbport (r62h_cutout-cards-hit)
    }
    return card_px;
}

// bbport (r63_leaf-stage4): what a ray met, for view 7 and the counters. A ray that met no card
// adds only to CARD_LAMP_RAYS, and only on a counted pass from a counted pixel.
void cardNote(CardRay hit) {
    const bool counted = (mode & MODE_CARD_COUNT) != 0u &&
                         ((gl_GlobalInvocationID.x | gl_GlobalInvocationID.y) & 7u) == 0u;
    if (counted) {
        atomicAdd(card_counts[CARD_LAMP_RAYS], 1u);
    }
    if (hit.seen == 0u) {
        return;
    }
    // (a ray that tested no card, met only cards without data, and was not stopped at the cap:
    // its own colour in view 7, so that it is not taken for a ray through clear texels)
    card_what |= hit.tested == 0u && hit.how != CARD_RAY_CAP ? CARD_WHAT_NO_DATA : 1u << hit.how;
    if (counted) {
        atomicAdd(card_counts[CARD_LAMP_CARD_RAYS], 1u);
        atomicAdd(card_counts[CARD_LAMP_TESTED], hit.tested);
        atomicAdd(card_counts[CARD_LAMP_NO_DATA], hit.no_data);
        atomicMax(card_counts[CARD_LAMP_MOST], hit.tested);
        atomicAdd(card_counts[CARD_LAMP_HOW + hit.how], 1u);
        atomicAdd(card_counts[CARD_LAMP_LOD_READS], hit.lod_reads); // bbport (r62g_cutout-shadows-visible)
        atomicAdd(card_counts[CARD_LAMP_ZERO_READS], hit.zero_reads);
        atomicAdd(card_counts[CARD_LAMP_PARTIAL_READS], hit.partial_reads);
        if (hit.tested == 0u) {
            atomicAdd(card_counts[CARD_LAMP_BLIND], 1u);
        }
    }
}

// bbport (r62g_cutout-shadows-visible): one counter's add on the passes and pixels cardNote counts.
void cardCount(uint index, uint n) {
    if ((mode & MODE_CARD_COUNT) != 0u && ((gl_GlobalInvocationID.x | gl_GlobalInvocationID.y) & 7u) == 0u) {
        atomicAdd(card_counts[index], n);
    }
}

// bbport (r62i_cutout-uv-proof): the proof of the chain "card hit -> pool record UV -> layer texel", for the pixels whose
// G-buffer surface is a card. A camera ray (origin 0, the TLAS's view space) to the pixel's point P meets every candidate
// up to just past it (no opaque flag, the others confirmed: rt_card_view.comp's way); the card candidate whose distance is
// nearest the pixel's depth distance, within CARD_VIEW_TOL_*, is the game's own surface there (the game's alpha test kept
// it), and cardTestLod reads it with the instance's slot, the primitive index and the barycentrics, as a lamp ray's
// read does, at level 0 with the game's reference (card_ref_scale is 1 outside a lamp ray's reads). The classes:
const uint PROOF_NO_CARD = 0u;   // the surface is not a card (or none within the tolerance)
const uint PROOF_KEPT = 1u;      // the layer keeps the texel (what must hold on a pixel the game kept)
const uint PROOF_ZERO = 2u;      // dropped on a texel of alpha 0
const uint PROOF_PARTIAL = 3u;   // dropped on a partly covered texel
const uint PROOF_NO_DATA = 4u;   // the card has no data (row not ready, layer gone, primitive past the pool)
const uint PROOF_UNJUDGED = 5u;  // the row's rule is the sun pass's, dithered, or keeps no alpha: not comparable
// bbport (r62j_cutout-rule-and-place): the proof's sampled pixels (1 in 16 of the counted passes, as proofCount), a read with
// the LAMP rule (reference scale, 2x2 maximum, wrap of clamped axes: what a lamp ray's read does at level 0), and a read at a
// card in front of the pixel's surface (the game dropped its texel there: the lamp rule must drop it too).
bool proofSampled() {
    return (mode & MODE_CARD_COUNT) != 0u && ((gl_GlobalInvocationID.x | gl_GlobalInvocationID.y) & 3u) == 0u;
}
CardResult cardReadLampRule(uint slot, uint primitive, vec2 bary) {
    card_ref_scale = CARD_REF_SCALE;
    card_dilate = CARD_GATHER != 0u;
    card_wrap_clamped = CARD_WRAP_CLAMPED != 0u;
    const CardResult lamp = cardTestLod(slot, primitive, bary, 0.0);
    card_ref_scale = 1.0;
    card_dilate = false;
    card_wrap_clamped = false;
    return lamp;
}
// bbport (r62k_cutout-lit-fence): whether a layer read keeps the texel by one fixed rule, all at the reference scale CARD_REF_SCALE and the
// configured wrap: 0 the bilinear value (r62h), 1 the maximum of the footprint's four texels (r62j), 2 the nearest texel. The globals
// are left as the lamp rays' code expects them (card_nearest as CARD_GATHER says; main sets it first). countRules adds one counter
// of three (first_counter + rule) for each rule that keeps.
bool cardKeptByRule(uint slot, uint primitive, vec2 bary, uint rule) {
    card_ref_scale = CARD_REF_SCALE;
    card_dilate = rule != 0u;
    card_nearest = rule == 2u;
    card_wrap_clamped = CARD_WRAP_CLAMPED != 0u;
    const bool kept = cardTestLod(slot, primitive, bary, 0.0).status == CARD_KEPT;
    card_ref_scale = 1.0;
    card_dilate = false;
    card_nearest = CARD_GATHER == 2u;
    card_wrap_clamped = false;
    return kept;
}
void countRules(uint slot, uint primitive, vec2 bary, uint first_counter) {
    for (uint rule = 0u; rule < 3u; ++rule) {
        if (cardKeptByRule(slot, primitive, bary, rule)) {
            atomicAdd(card_counts[first_counter + rule], 1u);
        }
    }
}
void proofFront(uint slot, uint primitive, vec2 bary) {
    const CardResult game = cardTestLod(slot, primitive, bary, 0.0);
    if (game.status == CARD_NO_DATA || (game.flags & (CARD_ROW_SUN | CARD_ROW_DITHER | CARD_ROW_CLEAR)) != 0u) {
        return;
    }
    const CardResult lamp = cardReadLampRule(slot, primitive, bary);
    atomicAdd(card_counts[CARD_LAMP_PROOF_FRONT_READS], 1u);
    if (game.alpha <= 0.0) {
        atomicAdd(card_counts[CARD_LAMP_PROOF_FRONT_ZERO], 1u);
    }
    if (game.status == CARD_KEPT) {
        atomicAdd(card_counts[CARD_LAMP_PROOF_FRONT_GAME_KEPT], 1u);
    }
    if (lamp.status == CARD_KEPT) {
        atomicAdd(card_counts[CARD_LAMP_PROOF_FRONT_LAMP_KEPT], 1u);
    }
    if (game.status != CARD_KEPT) { // bbport (r62l_cutout-steady-proof) TOOL: only the reads the game dropped can be false shadows
        countRules(slot, primitive, bary, CARD_LAMP_FRONT_BILIN); // bbport (r62k_cutout-lit-fence): the three rules' false shadows
    }
}
// bbport (r62l_cutout-steady-proof) TOOL: proof_quiet: cardProof adds to no counter (cardLit asks it only which kind of surface a pixel is)
bool proof_quiet = false;
// bbport (r62m_cutout-name-blocker) TOOL: the blocker book. ray_card_*: the card hit that stopped the last ray() (slot, BLAS primitive,
// barycentrics, level, place in view space; valid only when ray_card_kept); top_blk_*: the same for the ray to the pixel's strongest
// lamp (blockerTop copies them with top_card). bookAdd enters a lit and shadowed counted pixel's blocker in the book of the counters
// buffer (rt_card_layers_layout.h CARD_LAMP_BOOK): the card slot's entry gets the pixel, the hit's box, the hit-to-lamp and
// hit-to-surface distances, and whether the game's own rule keeps the texel there.
uint ray_card_slot = 0u;
uint ray_card_prim = 0u;
vec2 ray_card_bary = vec2(0.0);
float ray_card_lod = 0.0;
vec3 ray_card_at = vec3(0.0);
uint top_blk_slot = 0u;
uint top_blk_prim = 0u;
vec2 top_blk_bary = vec2(0.0);
float top_blk_lod = 0.0;
vec3 top_blk_at = vec3(0.0);
void blockerFromRay(vec3 hit_at) {
    ray_card_slot = card_kept_slot;
    ray_card_prim = card_kept_prim;
    ray_card_bary = card_kept_bary;
    ray_card_lod = card_kept_lod;
    ray_card_at = hit_at;
}
void blockerTop() {
    top_blk_slot = ray_card_slot;
    top_blk_prim = ray_card_prim;
    top_blk_bary = ray_card_bary;
    top_blk_lod = ray_card_lod;
    top_blk_at = ray_card_at;
}
void bookAdd(float lamp_m, float went_m) {
    const uint slot = top_blk_slot;
    if (slot == 0u) {
        atomicAdd(card_counts[CARD_LAMP_BOOK_NO_SLOT], 1u);
        return;
    }
    uint at = 0u;
    bool found = false;
    for (uint k = 0u; k < uint(CARD_BOOK_ENTRIES) && !found; ++k) {
        const uint entry = uint(CARD_LAMP_BOOK) + ((slot + k) % uint(CARD_BOOK_ENTRIES)) * uint(CARD_BOOK_WORDS);
        const uint was = atomicCompSwap(card_counts[entry], 0u, slot);
        if (was == 0u || was == slot) {
            at = entry;
            found = true;
        }
    }
    if (!found) {
        atomicAdd(card_counts[CARD_LAMP_BOOK_FULL], 1u);
        return;
    }
    const uvec3 cm = uvec3(clamp(top_blk_at * 100.0 + 3200.0, vec3(0.0), vec3(6400.0)));
    atomicAdd(card_counts[at + 1u], 1u);
    for (uint a = 0u; a < 3u; ++a) {
        atomicMax(card_counts[at + 2u + a], 6400u - cm[a]);
        atomicMax(card_counts[at + 5u + a], cm[a]);
    }
    atomicAdd(card_counts[at + 8u], uint(clamp(lamp_m, 0.0, 30.0) * 100.0));
    atomicAdd(card_counts[at + 9u], uint(clamp(went_m, 0.0, 30.0) * 100.0));
    // the game's own rule at the same hit and level (the ray's reference scale, dilation and wrap are reset: a plain read)
    if (cardTestLod(slot, top_blk_prim, top_blk_bary, top_blk_lod).status == CARD_KEPT) {
        atomicAdd(card_counts[at + 10u], 1u);
    }
}
uint cardProof(vec3 P, out CardResult r0, out bool kept_l1, out bool uv_outside) {
    r0 = CardResult(CARD_NO_DATA, 0.0, vec2(0.0), vec2(0.0), 0u);
    kept_l1 = false;
    uv_outside = false;
    const float depth_t = length(P);
    if (!(depth_t > 1e-3)) {
        return PROOF_NO_CARD;
    }
    const float tol = float(CARD_VIEW_TOL_REL) * depth_t + float(CARD_VIEW_TOL_ABS);
    rayQueryEXT query;
    rayQueryInitializeEXT(query, scene, gl_RayFlagsNoOpaqueEXT, 0xffu, vec3(0.0), 0.0, P / depth_t,
                          depth_t + 2.0 * tol);
    float best_diff = 1e30;
    uint front_left = (mode & MODE_CARD_COUNT) != 0u && !proof_quiet ? 6u : 0u; // bbport (r62k_cutout-lit-fence): every pixel of a counted pass (r62j: 1 in 16); r62l: not a quiet call
    uint best_slot = 0u, best_primitive = 0u;
    vec2 best_bary = vec2(0.0);
    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query, false) != gl_RayQueryCandidateIntersectionTriangleEXT) {
            continue;
        }
        const uint slot = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(query, false));
        if (slot == 0u) {
            rayQueryConfirmIntersectionEXT(query);
            continue;
        }
        if (front_left > 0u && rayQueryGetIntersectionTEXT(query, false) < depth_t - tol) {
            --front_left; // bbport (r62j_cutout-rule-and-place): a card in front of the surface
            proofFront(slot, uint(rayQueryGetIntersectionPrimitiveIndexEXT(query, false)),
                       rayQueryGetIntersectionBarycentricsEXT(query, false));
        }
        const float diff = abs(rayQueryGetIntersectionTEXT(query, false) - depth_t);
        if (diff < tol && diff < best_diff) {
            best_diff = diff;
            best_slot = slot;
            best_primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(query, false));
            best_bary = rayQueryGetIntersectionBarycentricsEXT(query, false);
        }
    }
    if (best_slot == 0u) {
        return PROOF_NO_CARD;
    }
    // (review) the nearest solid surface the ray met (a confirmed hit) is the pixel's surface when it lies at least as
    // near the depth as the card: the ground a few cm behind a grass card's clear texel, which the game shows there,
    // must not be read as that card (it would count as "dropped" and bias the proof toward a broken chain)
    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT &&
        abs(rayQueryGetIntersectionTEXT(query, true) - depth_t) <= best_diff) {
        return PROOF_NO_CARD;
    }
    r0 = cardTestLod(best_slot, best_primitive, best_bary, 0.0);
    if (r0.status == CARD_NO_DATA) {
        return PROOF_NO_DATA;
    }
    uv_outside = any(lessThan(r0.raw, vec2(-0.001))) || any(greaterThan(r0.raw, vec2(1.001)));
    kept_l1 = cardTestLod(best_slot, best_primitive, best_bary, 1.0).status == CARD_KEPT;
    if ((r0.flags & (CARD_ROW_SUN | CARD_ROW_DITHER | CARD_ROW_CLEAR)) != 0u) {
        return PROOF_UNJUDGED;
    }
    if (proofSampled() && !proof_quiet) { // bbport (r62j_cutout-rule-and-place): the lamp rule, the bins, the outside-0-1 pixels
        if (cardReadLampRule(best_slot, best_primitive, best_bary).status == CARD_KEPT) {
            atomicAdd(card_counts[CARD_LAMP_PROOF_LAMP_KEPT], 1u);
        }
        countRules(best_slot, best_primitive, best_bary, CARD_LAMP_JUDGED_BILIN); // bbport (r62k_cutout-lit-fence)
        if (r0.status != CARD_KEPT && r0.alpha > 0.0) {
            const float ratio = r0.alpha / max(uintBitsToFloat(card_rows[best_slot * 2u].w), 1e-6);
            atomicAdd(card_counts[ratio < 0.25 ? CARD_LAMP_PROOF_BIN1 : ratio < 0.5 ? CARD_LAMP_PROOF_BIN2
                                                                                    : CARD_LAMP_PROOF_BIN3], 1u);
        }
        if (uv_outside) {
            atomicAdd(card_counts[CARD_LAMP_PROOF_OUT_JUDGED], 1u);
            if (r0.status == CARD_KEPT) {
                atomicAdd(card_counts[CARD_LAMP_PROOF_OUT_KEPT], 1u);
            }
            card_wrap_clamped = true;
            const CardResult wrapped = cardTestLod(best_slot, best_primitive, best_bary, 0.0);
            card_wrap_clamped = false;
            if (wrapped.status == CARD_KEPT) {
                atomicAdd(card_counts[CARD_LAMP_PROOF_OUT_WRAP_KEPT], 1u);
            }
        }
    }
    return r0.status == CARD_KEPT ? PROOF_KEPT : r0.alpha <= 0.0 ? PROOF_ZERO : PROOF_PARTIAL;
}

// bbport (r62k_cutout-lit-fence): where a cut-out's lamp shadow falls on a brightly lit surface. For a pixel whose lamp rays were cast this
// frame: LIT = its strongest lamp (the record top_at) is within CARD_LIT_DIST metres of the surface and the lamp's light (lamp_light, the
// pixel's lamp light before the shadow) is at least CARD_LIT_SHARE of the pixel's light (lamp over lamp plus base_light, the larger
// channel); BLOCKED = a kept leaf texel stopped the ray to that lamp (top_card). Returns 0 neither, 1 lit, 2 blocked, 3 both. The counts
// (on the passes and pixels cardCount counts): the pixels, blocked, lit, both; for both, the sums the host divides by their number: the
// view-space position in cm (x and y plus 3200: 32 m either side), the pixel, the lamp's distance in cm, its share in %, and how much of
// the lamp light the pixel's shadow ratio takes, in %. Without the lit view (CARD_PROOF 3) a pixel cardCount does not count is skipped.
uint cardLit(vec3 P, vec3 lamp_light, vec3 base_light, uint top_at, bool top_card, float ratio, ivec2 px, float went) {
    const bool counted = (mode & MODE_CARD_COUNT) != 0u && ((gl_GlobalInvocationID.x | gl_GlobalInvocationID.y) & 7u) == 0u;
    if (top_at == 0u || card_split_off || !(counted || CARD_PROOF == 3u)) { // bbport (r62l_cutout-steady-proof) TOOL: a pixel of an off tile traced no card
        return 0u;
    }
    const vec3 lamp_at = vec3(word(top_at), word(top_at + 1u), word(top_at + 2u));
    const float dist = length(lamp_at - P);
    const float lamp = max(max(lamp_light.r, lamp_light.g), lamp_light.b);
    const float base = max(max(base_light.r, base_light.g), base_light.b);
    const float share = lamp / max(lamp + base, 1e-12);
    const bool lit = dist <= CARD_LIT_DIST && share >= CARD_LIT_SHARE;
    cardCount(CARD_LAMP_LIT_PIXELS, 1u);
    if (top_card) {
        cardCount(CARD_LAMP_LIT_BLOCKED, 1u);
    }
    if (lit) {
        cardCount(CARD_LAMP_LIT_BRIGHT, 1u);
    }
    if (lit && top_card) {
        cardCount(CARD_LAMP_LIT_BOTH, 1u);
        cardCount(CARD_LAMP_LIT_SUM_X, uint(clamp(P.x * 100.0 + 3200.0, 0.0, 6400.0)));
        cardCount(CARD_LAMP_LIT_SUM_Y, uint(clamp(P.y * 100.0 + 3200.0, 0.0, 6400.0)));
        cardCount(CARD_LAMP_LIT_SUM_Z, uint(clamp(P.z * 100.0, 0.0, 20000.0)));
        cardCount(CARD_LAMP_LIT_SUM_PX, uint(max(px.x, 0)));
        cardCount(CARD_LAMP_LIT_SUM_PY, uint(max(px.y, 0)));
        cardCount(CARD_LAMP_LIT_SUM_DIST, uint(min(dist, 15.0) * 100.0));
        cardCount(CARD_LAMP_LIT_SUM_SHARE, uint(share * 100.0));
        cardCount(CARD_LAMP_LIT_SUM_DEPTH, uint((1.0 - clamp(ratio, 0.0, 1.0)) * 100.0 + 0.5));
        // bbport (r62l_cutout-steady-proof) TOOL: how far from the surface the blocking texel lies (a blocker within 10 cm is the surface's
        // own neighbourhood: suspect), and whether the pixel is itself a card (a leaf lit and shadowed by other leaves) or a wall or ground
        // (what the picture is wanted for): one camera ray, on the counted pixels only, adding to no proof counter
        if (counted) {
            cardCount(CARD_LAMP_LIT_SUM_WENT, uint(clamp(went, 0.0, 3.0) * 100.0));
            if (went < 0.10) {
                cardCount(CARD_LAMP_LIT_NEAR, 1u);
            }
            bookAdd(length(lamp_at - top_blk_at), went); // bbport (r62m_cutout-name-blocker) TOOL
            proof_quiet = true;
            CardResult surface;
            bool surface_l1, surface_outside;
            const uint surface_class = cardProof(P, surface, surface_l1, surface_outside);
            proof_quiet = false;
            if (surface_class != PROOF_NO_CARD) {
                cardCount(CARD_LAMP_LIT_ON_CARD, 1u);
            }
        }
    }
    return (lit ? 1u : 0u) | (top_card ? 2u : 0u);
}

// One proof counter's add: on the counted passes (MODE_CARD_COUNT), from one pixel in 16.
void proofCount(uint index) {
    if ((mode & MODE_CARD_COUNT) != 0u && ((gl_GlobalInvocationID.x | gl_GlobalInvocationID.y) & 3u) == 0u) {
        atomicAdd(card_counts[index], 1u);
