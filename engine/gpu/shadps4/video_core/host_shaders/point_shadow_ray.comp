const uint YOUNG_SLOT = 13u;
#endif
float youngMean(ivec2 cell, ivec2 px, vec3 P, vec3 n, float answer) {
    const vec3 nn = n != vec3(0.0) ? n : surfaceNormal((vec2(px) + 0.5) / size, P);
