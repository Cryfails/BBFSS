            // A lamp that was not there the frame before has no history under its shadows (its
            // step is LampTrack::Lost): nothing is looked up, the state starts from the evidence.
            const bool new_lamp = top_step >= NEW_LAMP_STEP;
            float w_f = 0.0; // the share looked up where the lamp's motion puts it
            if ((history_flags & HISTORY_READ) != 0u && !new_lamp) {
                vec3 sa, sf;
                float fa, ff, la, lf;
                historyAt(P, history_at, vec3(0.0), sa, fa, la);
                sf = sa;
                ff = fa;
                lf = la;
                if (two) {
                    historyAt(P, history_at, top_moved, sf, ff, lf);
                }
                // The state's "moves with the lamp" part (above 0) is taken where the lamp's
                // motion puts it, its "stands" part (below 0) where the surface was, each made
                // whole over the taps found there (0 where none is); then faded, and moved by
                // this pixel's own evidence.
                const float la_whole = fa > 0.01 ? la / fa : 0.0, lf_whole = ff > 0.01 ? lf / ff : 0.0;
                const float prior = max(lf_whole, 0.0) + min(la_whole, 0.0);
                lam_kept = clamp(prior * FOLLOW_KEEP + FOLLOW_EVIDENCE * e, -FOLLOW_MOST, FOLLOW_MOST);
                if (two) {
                    float agree = 0.0;
                    if (fa > 0.01 && ff > 0.01) {
                        const float ra = sa.x / fa, rf = sf.x / ff;
                        const float ca = clamp(ra, 0.05, 0.95), cf = clamp(rf, 0.05, 0.95);
                        agree = FOLLOW_AGREE *
                                (answer * log(cf / ca) + (1.0 - answer) * log((1.0 - cf) / (1.0 - ca)));
                        unsure = abs(ra - rf);
                    }
                    w_f = 1.0 / (1.0 + exp(-(lam_kept + agree)));
                    // Nothing found where the surface was: the place the lamp's motion puts it
                    // is taken only where the state says what blocks the pixel moves with the
                    // lamp (the trail below bounds only the share that is not followed); else
                    // nothing is held and the pixel starts again.
                    if (!(fa > 0.01) && lam_kept <= 0.0) {
                        w_f = 0.0;
                    }
                    unsure *= 4.0 * w_f * (1.0 - w_f);
                }
                const float got = (1.0 - w_f) * fa + w_f * ff;
                if (got > 0.01) {
                    const vec3 both = (1.0 - w_f) * sa + w_f * sf;
                    held_ratio = both.x / got;
                    held_frames = both.y;
                    held_fast = both.z / got;
                    held = true;
                }
            } else {
                lam_kept = FOLLOW_EVIDENCE * e;
            }
            // What is not followed trails: the state's share that moves with the lamp by the
            // lamp's whole step, its share that stands by the far blockers' mean swing (0 with
            // no opinion; bbport r57_lamp-window: OWN_SWING without the window); m a frame, as
            // the vote's slip below.
            const float s = 1.0 / (1.0 + exp(-lam_kept));
            if (top_step > 0.0) {
                const float c_plus = max(2.0 * s - 1.0, 0.0), c_minus = max(1.0 - 2.0 * s, 0.0);
                // bbport (r57_lamp-window): without the window, OWN_SWING
                const float k = t_window ? (far_n > 0.0 ? swing / far_n : 0.0) : OWN_SWING;
                slip = (1.0 - w_f) * top_step * (c_plus + c_minus * k);
                looked = vec3(0.0, w_f, 1.0 - w_f);
            } else {
                looked = 0.25 * vec3(0.0, s, 1.0 - s);
            }
        } else {
            // carried: what shadows this place moves with the lamp. slip: how far the place the
            // history is looked up at is off for every frame it holds, m.
            const bool carried = near_n > far_n;
            const bool follows = carried && top_moved != vec3(0.0);
            if (top_step > 0.0) {
                if (carried) {
                    slip = follows ? 0.0 : top_step;
                } else if (far_n > 0.0) {
                    slip = top_step * swing / far_n;
                }
                looked = follows ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0);
            } else {
                looked = vec3(0.0, 0.2, 0.2);
            }
            held = (history_flags & HISTORY_READ) != 0u &&
                   blendHistory(P, history_at, follows ? top_moved : vec3(0.0), held_ratio, held_frames, held_fast);
        }
        if (held) {
            fast = mix(answer, held_fast, FAST_KEEP);
            frames = min(held_frames, word(history_at + 30u));
            const float trail = word(history_at + 31u);
            if (slip > 0.0 && trail > 0.0) {
                frames = min(frames, trail / slip);
            }
            if (t_follow_soft) {
                // bbport (r52_follow-soft): a share that is a guess between two places apart
                frames *= 1.0 - smoothstep(UNSURE_FROM, UNSURE_ALL, unsure);
            }
            if (t_reject > 0.0 && frames > 1.5) {
                // (A history of one frame is never dropped here: its ray and this one are all
                // there is.)
                frames *= 1.0 - smoothstep(REJECT_FROM * t_reject, t_reject, abs(fast - held_ratio));
            }
            const float around = word(history_at + 33u);
            if (around > 0.0) {
                float mean, spread;
                if (t_window) {
                    mean = sum / count;
                    spread = around * sqrt(max(sum2 / count - mean * mean, 0.0) + AROUND_FLOOR / count);
                } else {
                    // bbport (r57_lamp-window): one lamp's answers are 0 or 1, so a mean of fast
                    // has the variance fast * (1 - fast) / FAST_COUNT (with two lamps or more the
                    // answers vary less). The bound is at least 0.18 wide on each side and fast
                    // lags the change: a change of less than about 0.86 is not bound (see main).
                    mean = fast;
                    spread = around * sqrt((fast * (1.0 - fast) + AROUND_FLOOR) / FAST_COUNT);
                }
                const float fitted = clamp(held_ratio, min(mean - spread, answer), max(mean + spread, answer));
                const float taken = smoothstep(AROUND_FROM, AROUND_ALL, abs(fitted - held_ratio));
                frames *= 1.0 - taken;
                held_ratio = fitted;
                looked.r = taken;
            }
            ratio = mix(answer, held_ratio, frames / (frames + 1.0));
        }
        imageStore(history_cur, px, vec4(ratio, P.z, frames + 1.0, fast));
        if (t_follow_soft) { // bbport (r52_follow-soft)
            imageStore(follow_cur, px, vec4(lam_kept));
        }
#ifdef HALF
        }
#endif
    } else if ((history_flags & HISTORY_WRITE) != 0u) {
        imageStore(history_cur, px, vec4(ratio, P.z, stable, 1.0));
    }
    const float scale = mix(1.0, ratio, strength * fade);
    vec3 out0 = s0 + d0 * scale, out1 = s1 + d1 * scale;
    if (t_view != 0u) {
        // bbport (r41_lamp-shadows): BB_LAMP_SHADOW_VIEW, on pixels the pass shadows, in place of
        // their light (the game multiplies it by the surface's colour). 1: the shadow ratio as
        // this frame's rays gave it. 2: how many lamp records have weight here (1 blue, 2 green,
        // 3 yellow, 4 or more red), dimmer the smaller the strongest one's share. 3: rays this
        // pixel cast (0 blue, 1 green, 2 yellow, 3 or more red). bbport (r42_lamp-soft): 4: the
        // ratio as it is used, averaged over the frames (the same as 1 without a history). 5:
        // the frames of history in it, red none to green all it may hold (blue: this pass
        // averages nothing). 6: where the history was looked up: green where a moving lamp's
        // motion puts it, blue where the surface was under a moving lamp, dim under a lamp
        // that stands; red: how much of it this frame's answers around the pixel took away.
        // bbport (r52_follow-soft): with the soft follow, 6 under a moving lamp: green the share
        // of the history looked up where its motion puts it, blue the rest; under a lamp that
        // stands, dim: the follow state (green moves with the lamp, blue stands).
        // The history and the half-resolution answers hold the ratio as always.
        vec3 shown = vec3(answer);
        if (t_view == 2u) {
            shown = stepColour(lamps - 1u) * (0.25 + 0.75 * view_top / wsum);
        } else if (t_view == 3u) {
            shown = stepColour(rays_cast);
        } else if (t_view == 4u) {
            shown = vec3(ratio);
        } else if (t_view == 5u) {
            shown = vec3(0.0, 0.0, 1.0);
            if (blend) {
                const float held = clamp(frames / max(word(history_at + 30u), 1.0), 0.0, 1.0);
                shown = vec3(1.0 - held, held, 0.0);
            }
        } else if (t_view == 6u) {
            shown = looked;
        }
        out0 = shown * t_gain;
        out1 = vec3(0.0);
    }
    imageStore(cur0, px, vec4(out0, 1.0));
    imageStore(cur1, px, vec4(out1, 1.0));
    if (apart) {
        imageStore(snap0, px, vec4(0.0));
        imageStore(snap1, px, vec4(0.0));
    }
#ifdef HALF
    if (first) {
        imageStore(half_answers, px >> 1,
                   n == vec3(0.0) ? vec4(-1.0) : vec4(ratio, P.z, OctEncode(n)));
    }
    const uint slot = group_trace == 0u ? (first ? 3u : 7u)
                                        : (first ? 1u : (half_why == HALF_TAKEN ? 4u : 5u));
    HalfCount(first, slot, half_why);
#endif
}
