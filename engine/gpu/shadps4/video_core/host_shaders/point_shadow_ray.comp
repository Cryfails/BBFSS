    bool card_own = false, card_ring = false;
    const float own_a = CARD_BLOCKS != 0u && own.x >= 2.0 ? own.x - 4.0 : own.x;
#endif
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
#ifdef CARDS
            const ivec2 at = clamp(block + ivec2(x, y), lo, hi);
            float q = imageLoad(half_answers, at).x;
#else
            const float q = imageLoad(half_answers, clamp(block + ivec2(x, y), lo, hi)).x;
#endif
            if (!(q >= 0.0)) {
                return HALF_NO_ANSWER;
            }
#ifdef CARDS
            bool marked = CARD_BLOCKS != 0u && q >= 2.0;
            q = marked ? q - 4.0 : q;
#ifdef CENTRED
            marked = marked || (CARD_BLOCKS != 0u && card_blocks_split && (imageLoad(lamp_answers, at * 2).x & 1u) != 0u);
#endif
            if (marked) {
                if (x == 0 && y == 0) {
                    card_own = true;
                } else {
                    card_ring = true;
                }
            }
            if (abs(q - own_a) > HALF_AGREE) {
#else
            if (abs(q - own.x) > HALF_AGREE) {
#endif
                return HALF_DIFFER;
            }
        }
    }
#ifdef COLOUR
    // bbport (r92_lamp-shadow-colour): and their colours agree as their ratios must (a pixel that takes
    // its block's ratio takes its colour too; blocks that agree in the ratio but not in the colour,
    // another lamp blocked by the same share, are traced, as the full-resolution pass would show
    // them): the colour each block's pixel left in this pass (colour_block_row: the averaged one, or
    // without the averaging its answer).
