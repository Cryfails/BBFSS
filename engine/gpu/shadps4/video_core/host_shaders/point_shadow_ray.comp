#version 460
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(scalar, set = 0, binding = 0) readonly buffer Data { uint d[]; } data;
layout(set = 0, binding = 1) uniform sampler2D depth_tex;
layout(set = 0, binding = 2, r11f_g11f_b10f) uniform image2D cur0;
// snap0, snap1: the light targets as they were before the lamps were drawn; with MODE_APART the
// lamps' light alone (drawn there instead of into the light targets), which this pass moves into
// the light targets and zeroes.
layout(set = 0, binding = 3, r11f_g11f_b10f) uniform image2D snap0;
layout(set = 0, binding = 4, r11f_g11f_b10f) uniform image2D cur1;
layout(set = 0, binding = 5, r11f_g11f_b10f) uniform image2D snap1;
layout(set = 0, binding = 6) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 7, rgba16f) uniform readonly image2D history_prev;
#ifdef HALF
// bbport (r44_half-area-lamp): read as well: a pixel that takes its block's answer takes the
// age of that answer from what the first pass stored for the block's pixel.
layout(set = 0, binding = 8, rgba16f) uniform image2D history_cur;
#else
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D history_cur;
#endif
// bbport (r52_follow-soft): the follow state, one float a pixel, kept beside the history (two
// images taken in turn with it): how sure the pass is that what blocks the pixel's strongest
// lamp moves with that lamp, as log-odds (above 0 it does, below 0 it stands, 0 no opinion, at
// most FOLLOW_MOST either way). With word 0 bit 20 (t_follow_soft) written wherever the
// averaging (HISTORY_BLEND) writes its history and read only through history texels that passed
// the depth test (historyAt); without it neither read nor written.
#ifdef HALF
layout(set = 0, binding = 11, r32f) uniform readonly image2D follow_prev;
layout(set = 0, binding = 12, r32f) uniform image2D follow_cur;
#else
layout(set = 0, binding = 9, r32f) uniform readonly image2D follow_prev;
layout(set = 0, binding = 10, r32f) uniform writeonly image2D follow_cur;
#endif
#ifdef CENTRED
// bbport (r60_lamp-centred-window): BB_LAMP_SHADOW_WINDOW=2 only (the builds made with CENTRED,
// point_shadow_ray_centred_comp and point_shadow_ray_half_centred_comp; the two builds without it
// are the pass as before, word for word). The pass that averages runs as two dispatches of this
// shader: MODE_TRACE casts the rays and stores what they said here; MODE_RESOLVE casts none and does
// the rest (the history, the light) with the ghost clamp's window centred on every pixel (see main).
// One texel a pixel: x this frame's answer (its float bits; below 0: the pixel has none), y the cast
// code (castCode, a half float in the high 16 bits) and the strongest lamp's record / 16 (low 16).
#ifdef HALF
layout(set = 0, binding = 13, rg32ui) uniform uimage2D lamp_answers;
#else
layout(set = 0, binding = 11, rg32ui) uniform uimage2D lamp_answers;
#endif
#endif
#ifdef RESOLVE
// bbport (r61_lamp-window-cost): the resolve's own builds (point_shadow_ray_resolve_comp and
// point_shadow_ray_half_resolve_comp): the centred build in which every dispatch is a resolve
// (main takes MODE_RESOLVE as set and MODE_TRACE as clear), so the rays, the tile list and the
// trace's stores cannot be reached. The SPIR-V still holds them; the saving needs the driver to drop
// that dead code and give the build the registers of a pass that only loads and blends. Same bindings
// and push constants as the centred build; the host runs it for the resolves only
// (vk_point_shadow.cpp, BB_LAMP_SHADOW_RESOLVE_BUILD).
#ifndef CENTRED
#error "RESOLVE is a form of the CENTRED build"
#endif
#endif
#ifdef HALF
// bbport (r32_lamp-half): BB_LAMP_SHADOW_HALF=1 only (the point_shadow_ray_half_comp build).
// half_answers: one texel per 2x2 block, written by the first pass: (shadow ratio, view depth,
// normal in octahedral form); a ratio below 0: no answer for the block. half_counts: what the
// two passes did (PointShadow::OnFrameEnd prints it).
layout(set = 0, binding = 9, rgba16f) uniform image2D half_answers;
layout(scalar, set = 0, binding = 10) buffer HalfCounts { uint n[]; } half_counts;
uint half_rays = 0u; // rays this invocation cast (visibility)
#endif

layout(push_constant) uniform Constants {
    uint first_light;
    uint frame_index;
    vec2 size;
    float length_m;
    uint mode; // the screen-space pass has its thickness here
    float strength;
    float fade_start_m;
    float fade_end_m;
    uint light_count;
    uint steps;
    float bias_m;
    ivec4 rect;
};

const float LAMP_CLEARANCE = 0.35;

const uint MAX_GROUP_TILES = 256u;

shared mat4 shared_inverse;
shared uint group_tiles[MAX_GROUP_TILES];
shared uint group_count;

float word(uint i) { return uintBitsToFloat(data.d[i]); }
vec4 row(uint i) { return vec4(word(i), word(i + 1u), word(i + 2u), word(i + 3u)); }

// bbport (r41_lamp-shadows): the repair. MODE_REPAIR in `mode`: bits 8-31 of `mode` are the
// place in `data` of sixteen tuning words (vk_point_shadow.cpp Flush, lamp_shadow_tune.h
// LampTuneWords). Clear (experiment 35184372088832 set, or a caller that knows nothing of it):
// the values below stay as they are here, which is the pass of before: the old weights, a point
// lamp, LAMP_CLEARANCE, the ray's start where it was, no view.
// bbport (r42_lamp-soft): the lamp is an area light. A flame is not a point: a point lamp
// magnifies a torch stick, an arm or a weapon handle next to the flame into a long hard band,
// and r41's answer (rays to the lamp's rim, one free ray = lit) could not tell a stick from a
// body: a radius that removed the stick's band ate the body's shadow. Now every traced lamp
// gets one ray a frame to a point of its disc (radius t_radius, facing the surface), the point
// taken from a sequence that covers the disc evenly over the frames (samplePoint), and the
// pixel's shadow ratio is averaged over the frames in the history image (HISTORY_BLEND). A thin
// caster near the lamp then covers a small part of the disc from every place: a faint wide
// smear. A body covers all of it in its core and less towards its rim: a penumbra that widens
// with the distance behind the caster. No more rays than a point lamp casts. t_radius 0: the
// point lamp, the same ray every frame, no history (BB_LAMP_SHADOW_SOFT=0).
// bbport (r44_half-area-lamp): the half-resolution build has the area lamp too, where the pass
// averages (HISTORY_BLEND). Its first pass averages the pixel it traces for each 2x2 block as
// the full-resolution pass averages every pixel, and stores that averaged ratio as the block's
// answer: averaged answers are 0 or 1 outside a penumbra, so the blocks there agree and are
// shared as before; inside a penumbra they differ, and each pixel casts its own ray to the
// lamp's disc and averages it in its own history (the history images are of full resolution).
// So where a shadow has an edge or a penumbra every pixel is worked out as at full resolution,
// and only flat light or flat shadow is shared. Without HISTORY_BLEND the half-resolution build
// keeps the point lamp (main): one bare ray to a point of the disc, shared by four pixels,
// would be noise in blocks.
const uint MODE_REPAIR = 16u;
bool new_w = false;             // weights follow the game's falloff and the surface's facing
bool inv_sq = false;            // the game's lamps use the inverse-square curve
uint t_view = 0u;               // debug view (BB_LAMP_SHADOW_VIEW)
bool t_follow_soft = false;     // bbport (r52_follow-soft): BB_LAMP_SHADOW_FOLLOW_SOFT
bool t_window = true;           // bbport (r57_lamp-window): BB_LAMP_SHADOW_WINDOW (true: the pass of before)
#ifdef CENTRED
bool t_centred = false;         // bbport (r60_lamp-centred-window): BB_LAMP_SHADOW_WINDOW=2 (with t_window)
#endif
float t_clear = LAMP_CLEARANCE; // blind sphere at the lamp, m
float t_radius = 0.0;           // the lamp's radius, m; 0: a point
uint t_frame = 0u;              // the frame counter (the sample points' sequence)
float t_self = 0.0;             // grazing self skip, m
float t_wrap = 0.0;             // N.L tolerance of the weights; 1: no N.L
float t_core2 = 0.0;            // the inverse-square curve's core, squared
float t_gain = 1.0;             // brightness of the view
float t_floor = 0.0;            // least facing factor of the weights
float t_reject = 0.0;           // the history is dropped where the last frames differ this much
// Two axes of the world, in view space (this pass works in view space): the lamp's disc is laid
// out against them.
vec3 t_axis_a = vec3(1.0, 0.0, 0.0);
vec3 t_axis_b = vec3(0.0, 1.0, 0.0);
uint rays_cast = 0u;            // rays this invocation cast (view 3)
// bbport (r42_lamp-soft): of the ray cast last, if it was blocked: from its start to the hit and
// from the hit on to its target, m (ray_left below 0: it was free, or not cast).
float ray_went = 0.0;
float ray_left = -1.0;

// Called once a workgroup has a tile (an empty one reads nothing).
void loadTune() {
    if ((mode & MODE_REPAIR) == 0u) {
        return;
    }
    const uint at = mode >> 8u;
    const uint f = data.d[at];
    new_w = (f & 1u) != 0u;
    inv_sq = (f & 2u) != 0u;
    t_view = (f >> 8u) & 7u;
    t_follow_soft = (f & (1u << 20u)) != 0u; // bbport (r52_follow-soft); bits 12-17 are not used
    t_window = (f & (1u << 21u)) != 0u;      // bbport (r57_lamp-window)
#ifdef CENTRED
    t_centred = (f & (1u << 22u)) != 0u;     // bbport (r60_lamp-centred-window)
#endif
    t_clear = word(at + 1u);
    t_radius = word(at + 2u);
    t_frame = data.d[at + 3u];
    t_self = word(at + 4u);
    t_wrap = word(at + 5u);
    t_core2 = word(at + 6u);
    t_gain = word(at + 7u);
    t_floor = word(at + 8u);
    t_reject = word(at + 9u);
    t_axis_a = vec3(word(at + 10u), word(at + 11u), word(at + 12u));
    t_axis_b = vec3(word(at + 13u), word(at + 14u), word(at + 15u));
}

// The views' colour for a count: 0 blue, 1 green, 2 yellow, 3 or more red.
vec3 stepColour(uint k) {
    return k == 0u ? vec3(0.0, 0.0, 1.0)
                   : k == 1u ? vec3(0.0, 1.0, 0.0) : k == 2u ? vec3(1.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
}

// A lamp's weight in the pixel's shadow ratio: about its share of the lamps' light there.
// to_light: from the surface to the lamp; t2: its length squared over the radius squared.
// Before (and with BB_LAMP_SHADOW_WEIGHTS=0): (1 - t2)^2 * luma. The game's own curve is
// (1 - d/r)^2 (vk_local_falloff.h), or 1 / (t2 + core^2) - 1 / (1 + core^2) with
// startup_local_inverse_square, and its light goes with N.L: the old weight overrated a lamp far
// away or behind the surface, so that lamp's shadow took the nearer lamp's light and the nearer
// lamp's shadow took too little. The normal is the one from depth: t_wrap forgives its error,
// and the facing never falls below t_floor: it ranks the lamps, it does not remove one. (A pixel
// whose only lamp had no weight would get no ray and keep that lamp's light unshadowed, also
// inside a wall's shadow; and the normal is arbitrary on features a pixel or two wide.) With the
// floor a lamp behind the surface keeps a ray, which its own surface blocks, as before.
float lampWeight(vec3 to_light, float t2, vec3 col, vec3 n) {
    const float l = dot(col, vec3(0.299, 0.587, 0.114));
    if (!new_w) {
        float w = 1.0 - t2;
        w *= w * l;
        return w;
    }
    float f = 1.0 - sqrt(t2);
    f *= f;
    if (inv_sq) {
        f = max(0.0, 1.0 / max(t2 + t_core2, 1e-6) - 1.0 / (1.0 + t_core2));
    }
    float facing = 1.0;
    if (t_wrap < 1.0 && n != vec3(0.0)) {
        facing = clamp((dot(n, to_light) * inversesqrt(max(dot(to_light, to_light), 1e-8)) + t_wrap) /
                           (1.0 + t_wrap),
                       t_floor, 1.0);
    }
    return f * facing * l;
}

vec3 viewPosAt(vec2 uv, float depth) {
    vec4 v = shared_inverse * vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    return v.xyz / v.w;
}

vec3 surfaceNormal(vec2 uv, vec3 P) {
    const vec2 px = 1.0 / size;
    vec3 best[2];
    for (int axis = 0; axis < 2; ++axis) {
        const vec2 step_uv = axis == 0 ? vec2(px.x, 0.0) : vec2(0.0, px.y);
        const vec3 a = viewPosAt(uv + step_uv, textureLod(depth_tex, uv + step_uv, 0.0).x) - P;
        const vec3 b = P - viewPosAt(uv - step_uv, textureLod(depth_tex, uv - step_uv, 0.0).x);
        best[axis] = abs(a.z) < abs(b.z) ? a : b;
    }
    vec3 n = cross(best[1], best[0]);
    const float len = length(n);
    if (!(len > 1e-12)) {
        return vec3(0.0);
    }
    n /= len;
    return dot(n, P) > 0.0 ? -n : n;
}

// bbport (r41_lamp-shadows): one ray from `origin` towards `target` (the lamp's centre or a
// point of its disc), blind within t_clear of the target. Below 0: free. Else blocked: how far
// along the way to the target the hit lies, 0 to 1 (a hit, not always the nearest: the ray stops
// at its first). (Before: visibility(), 1 free and 0 blocked, with LAMP_CLEARANCE; with the
// repair off t_clear is that constant and the query is the same.)
float ray(vec3 origin, float reach, vec3 target) {
    const vec3 ray_to = target - origin;
    const float ray_len = length(ray_to);
    const float tmax = ray_len - t_clear;
    ray_left = -1.0;
    if (!(tmax > reach)) {
        return -1.0;
    }
    ++rays_cast;
#ifdef HALF
    ++half_rays;
#endif
    rayQueryEXT query;
    // 0x04: everything but cut-out cards (vk_rt_shadow.cpp LampMask).
    rayQueryInitializeEXT(query, scene, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0x04u,
                          origin, reach * 0.5, ray_to / ray_len, tmax);
    rayQueryProceedEXT(query);
    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        return -1.0;
    }
    ray_went = rayQueryGetIntersectionTEXT(query, true);
    ray_left = ray_len - ray_went;
    return ray_went / ray_len;
}

// bbport (r42_lamp-soft): a point of the unit square for this pixel and frame. Over the frames
// a pixel walks the R2 sequence (steps of 1/1.3247 and 1/1.3247^2 of the square, in 32-bit
// fixed point so that it never loses its place): any run of frames covers the square evenly,
// which is what lets nine or so frames stand for the whole disc. Each pixel starts from a place
// of its own (interleaved gradient noise in each direction), so neighbours hold different
// points and what noise is left has no pattern the eye or the upscaler could follow.
vec2 samplePoint(ivec2 p, uint frame) {
    const vec2 q = vec2(p);
    const vec2 start = vec2(fract(52.9829189 * fract(dot(q, vec2(0.06711056, 0.00583715)))),
                            fract(52.9829189 * fract(dot(q.yx + vec2(19.0, 73.0), vec2(0.06711056, 0.00583715)))));
    const uvec2 walked = frame * uvec2(3242174889u, 2447445414u);
    return fract(start + vec2(walked >> 8u) * (1.0 / 16777216.0));
}

// bbport (r41_lamp-shadows, r42_lamp-soft): whether the lamp at L lights the surface at P, by
// one ray: 1 or 0.
//  - Grazing self skip: the ray starts reach off the surface along a normal worked out from
//    depth, and at a flat angle it stays close to the surface it left for a long way: layered
//    cloth and hair cards shadowed themselves in polygon-shaped patches. The start is lifted
//    along the normal by t_self * (1 - N.L)^2 more. (Lifted, not "hits count from further along
//    the ray": that would also pass a thin wall or prop standing next to the pixel.)
//  - The lamp is a disc of radius t_radius that faces the surface, and the ray goes to the point
//    of it that xi names (uniform over the disc's area). The disc is laid out against two axes
//    of the world (t_axis_a, a horizontal one, and t_axis_b, up; where the ray runs within 26
//    degrees of the first the second takes over). t_radius 0: the ray goes to L.
//  - No point of the disc lies lower over the surface's own plane than the lamp's centre does
//    (or than the ray's start, where the centre is higher than that): a lamp that sits closer
//    to a floor, a table or a wall than its radius (a candle) would have part of its disc under
//    that surface, and the surface would shadow itself there (a lamp 5 cm over bare ground lost
//    a tenth of its light with a radius of 0.1 m, a quarter at 2 cm). Such a point is lifted
//    along the normal. A lamp higher than its radius over the plane is not touched, and a lamp
//    behind the surface keeps the part of its disc that looks over the edge (the soft rim of
//    the lit side of a body).
float lampVisibility(vec3 P, vec3 n, vec3 origin, float reach, vec3 L, vec2 xi) {
    vec3 from = origin;
    if (t_self > 0.0 && n != vec3(0.0)) {
        const float g = 1.0 - clamp(dot(n, normalize(L - P)), 0.0, 1.0);
        from += n * (t_self * g * g);
    }
    vec3 target = L;
    if (t_radius > 0.0) {
        const vec3 dir = normalize(L - from);
        const vec3 across = cross(dir, abs(dot(dir, t_axis_a)) < 0.9 ? t_axis_a : t_axis_b);
        const float len2 = dot(across, across);
        if (len2 > 1e-6) {
            const vec3 u = across * inversesqrt(len2);
            const vec3 v = cross(dir, u);
            const float a = 6.2831853 * xi.y;
            target += (t_radius * sqrt(xi.x)) * (cos(a) * u + sin(a) * v);
            // (n zero: no normal, nothing is lifted)
            target += n * max(min(reach, dot(n, L - P)) - dot(n, target - P), 0.0);
        }
    }
    return ray(from, reach, target) < 0.0 ? 1.0 : 0.0;
}

bool inside(uint tile, ivec2 lo, ivec2 hi) {
    const uint at = first_light + tile * 8u;
    const ivec4 r = ivec4(data.d[at], data.d[at + 1u], data.d[at + 2u], data.d[at + 3u]);
    return r.x < hi.x && lo.x < r.z && r.y < hi.y && lo.y < r.w;
}

const uint MODE_APART = 1u;
const uint HISTORY_READ = 1u;
const uint HISTORY_WRITE = 2u;
// bbport (r42_lamp-soft): the history averages the shadow ratio over the frames (texel: the
// ratio, view depth, frames it holds, the mean of the last few frames) in place of LANTERN_RT_
// LAMP_REUSE's "copy what a settled block held" (the ratio, view depth, settled frames, 1).
// Word 30 of the history block: the most frames a texel may hold; word 31: how far a moving
// lamp's shadows may trail, m; word 32: what blocks a moving lamp within this distance of it is
// taken to move with it, m; word 33: how many deviations of the answers around a pixel its
// history may lie from their mean (0: any). With it, words 12 to 14 of every lamp record: how
// far the lamp moved since the frame before, in that frame's view space (LampTrack::Shift;
// zero: it stands, or the pass does not follow lamps), and word 15: that distance, m
// (LampTrack::Step; very large: the lamp was not there the frame before).
const uint HISTORY_BLEND = 4u;
const float FAST_KEEP = 0.6; // the last frame's share in the mean of the last few frames
// bbport (r57_lamp-window): how many frames that mean stands for (its variance is that of so many
// answers): (1 + FAST_KEEP) / (1 - FAST_KEEP), 4.
const float FAST_COUNT = (1.0 + FAST_KEEP) / (1.0 - FAST_KEEP);
// bbport (r57_lamp-window): without the window, the swing of the "stands" share under a moving
// lamp (the shadow's step over the lamp's): one value for every pixel, so that the cap of its
// frames does not depend on whether this frame's ray was blocked (a cap on the blocked frames
// alone weighs the dark answers more and darkens a standing penumbra). 1: a blocker halfway
// between the lamp and the surface. A guess, not measured.
const float OWN_SWING = 1.0;
// The reject sets in at this share of t_reject. One ray that disagrees with the history moves
// the mean of the last few frames by 1 - FAST_KEEP = 0.4 at most, and must not drop the history
// (in a penumbra every other ray disagrees): lamp_shadow_tune.h keeps t_reject at 0.45 or more.
const float REJECT_FROM = 0.9;
// The history against this frame's answers around the pixel (see main): the variance a pixel's
// answers are taken to have at the least (over the answers counted; 0.25 is a coin's), and how
// far the history may lie outside before it is given up (from, wholly). bbport (r57_lamp-window):
// without the window, against the pixel's own last few frames (over FAST_COUNT).
const float AROUND_FLOOR = 0.05;
const float AROUND_FROM = 0.05;
const float AROUND_ALL = 0.3;
const float STABLE_FRAMES = 3.0;
const float STABLE_CHANGE = 0.05;

// bbport (r42_lamp-soft): what the averaging history (HISTORY_BLEND) of the frame before holds
// for the surface at P: its shadow ratio, the frames in it (times the part of it that was
// found) and the mean of its last few frames. False: nothing (the place was off the screen, or
// held another surface).
//  - The place: where the surface was in the view of the frame before, and from there back by
//    `moved`, the motion of the pixel's strongest lamp: a torch's shadows of what is carried
//    with it (its carrier, on the ground and on the carrier itself) move as the torch does, so
//    that is where the frame before holds them. Zero for a lamp that stands.
//  - The four texels around that place, each only if it held this surface (by its depth),
//    weighted as a bilinear lookup and made whole again: an average carried over many frames
//    must not snap to whole pixels while the camera moves, and must not take in a neighbour's
//    history across a depth edge. (A still camera lands on its own texel: nothing is blurred.)
// main() calls it after its rays: called before them, what it finds had to be kept across the
// ray queries, and the pass measured slower for it even where nothing is averaged.
bool blendHistory(vec3 P, uint history_at, vec3 moved, out float ratio, out float frames, out float fast) {
    const vec4 v = vec4(P, 1.0);
    const vec3 p = vec3(dot(row(history_at + 2u), v), dot(row(history_at + 6u), v), dot(row(history_at + 10u), v)) - moved;
    const vec4 clip = vec4(dot(row(history_at + 14u), vec4(p, 1.0)), dot(row(history_at + 18u), vec4(p, 1.0)),
                           dot(row(history_at + 22u), vec4(p, 1.0)), dot(row(history_at + 26u), vec4(p, 1.0)));
    if (!(clip.w > 1e-4)) {
        return false;
    }
    const vec2 ndc = clip.xy / clip.w;
    const vec2 was = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5) * size;
    if (any(lessThan(was, vec2(0.0))) || any(greaterThanEqual(was, size))) {
        return false;
    }
    const vec2 centre = was - 0.5;
    const ivec2 h0 = ivec2(floor(centre));
    const vec2 part = centre - vec2(h0);
    vec3 sum = vec3(0.0);
    float found = 0.0;
    for (int k = 0; k < 4; ++k) {
        const ivec2 o = ivec2(k & 1, k >> 1);
        const float w = (o.x == 0 ? 1.0 - part.x : part.x) * (o.y == 0 ? 1.0 - part.y : part.y);
        const ivec2 q = h0 + o;
        if (w > 0.004 && all(greaterThanEqual(q, ivec2(0))) && all(lessThan(q, ivec2(size)))) {
            const vec4 h = imageLoad(history_prev, q);
            if (h.g > 0.0 && abs(h.g - p.z) < 0.03 * p.z + 0.02) {
                sum += w * h.rba;
                found += w;
            }
        }
    }
    if (!(found > 0.01)) {
        return false;
    }
    ratio = sum.x / found;
    frames = sum.y;
    fast = sum.z / found;
    return true;
}

// bbport (r52_follow-soft): the follow share of the history, worked out per pixel from what the
// pixel has itself: its own ray's blocker, the follow state the history holds at the two places
// it may be looked up at, and how well each place fits this frame's answer. Nothing of it comes
// from the workgroup's shared answers.
const float FOLLOW_EVIDENCE = 3.0; // log-odds one blocked ray adds (near the lamp) or takes (far)
const float FOLLOW_MOST = 5.0;     // the state's bound either way (logistic: 0.993)
const float FOLLOW_KEEP = 0.95;    // the share of the state kept a frame; the rest fades to 0
const float FOLLOW_AGREE = 0.5;    // weight of this frame's answer's fit to each place (not kept)
const float UNSURE_FROM = 0.2;     // the history is shortened where the share is unsure and the
const float UNSURE_ALL = 0.6;      // two places differ: from, wholly
const float NEW_LAMP_STEP = 500.0; // m, half of LampTrack::Lost (1000 m): the step the host hands
                                   // for a lamp that was not there the frame before

// bbport (r52_follow-soft): the follow state the frame before left at q. A value the pass does
// not store (not a number, or beyond FOLLOW_MOST) counts as no opinion.
float stateAt(ivec2 q) {
    const float x = imageLoad(follow_prev, q).x;
    return abs(x) <= FOLLOW_MOST ? x : 0.0;
}

// bbport (r52_follow-soft): blendHistory's look-up at one place, not made whole: sum = the found
// taps' bilinear weights times (ratio, frames, fast), found = those weights' sum, lam = those
// weights times the follow state there. Nothing found: all three 0.
void historyAt(vec3 P, uint history_at, vec3 moved, out vec3 sum, out float found, out float lam) {
    sum = vec3(0.0);
    found = 0.0;
    lam = 0.0;
    const vec4 v = vec4(P, 1.0);
    const vec3 p = vec3(dot(row(history_at + 2u), v), dot(row(history_at + 6u), v), dot(row(history_at + 10u), v)) - moved;
    const vec4 clip = vec4(dot(row(history_at + 14u), vec4(p, 1.0)), dot(row(history_at + 18u), vec4(p, 1.0)),
                           dot(row(history_at + 22u), vec4(p, 1.0)), dot(row(history_at + 26u), vec4(p, 1.0)));
    if (!(clip.w > 1e-4)) {
        return;
    }
    const vec2 ndc = clip.xy / clip.w;
    const vec2 was = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5) * size;
    if (any(lessThan(was, vec2(0.0))) || any(greaterThanEqual(was, size))) {
        return;
    }
    const vec2 centre = was - 0.5;
    const ivec2 h0 = ivec2(floor(centre));
    const vec2 part = centre - vec2(h0);
    for (int k = 0; k < 4; ++k) {
        const ivec2 o = ivec2(k & 1, k >> 1);
        const float w = (o.x == 0 ? 1.0 - part.x : part.x) * (o.y == 0 ? 1.0 - part.y : part.y);
        const ivec2 q = h0 + o;
        if (w > 0.004 && all(greaterThanEqual(q, ivec2(0))) && all(lessThan(q, ivec2(size)))) {
            const vec4 h = imageLoad(history_prev, q);
            if (h.g > 0.0 && abs(h.g - p.z) < 0.03 * p.z + 0.02) {
                sum += w * h.rba;
                found += w;
                lam += w * stateAt(q);
            }
        }
    }
}

shared uint group_trace;
// bbport (r42_lamp-soft): averaging (HISTORY_BLEND), what each pixel of the workgroup found on
// this frame: its answer (the shadow ratio its rays gave; below 0: the pass does not shadow the
// pixel), and what blocked the ray to its strongest lamp if that lamp moves: -1 nothing (or the
// lamp stands), -2 something near the lamp (within word 32 of it), else how far the hit lies
// from the pixel over how far it lies from the lamp.
// bbport (r44_half-area-lamp): in the half-resolution build too. Its first pass's workgroup
// holds the 8x8 block pixels of 16x16 pixels (the answers around a pixel are those of the
// blocks around it). In its second pass a pixel that took its block's answer gives that
// averaged ratio as its answer, and a pixel the first pass did has none.
shared float group_answer[64];
shared float group_cast[64];

#ifdef CENTRED
// bbport (r60_lamp-centred-window): more bits of `mode` (vk_point_shadow.cpp ModeTrace, ModeResolve),
// set by the host only on the pass that averages (HISTORY_BLEND) with word 0 bit 22 set.
const uint MODE_TRACE = 32u;
const uint MODE_RESOLVE = 64u;
// What the trace stores of the ray to the pixel's strongest lamp: in one value the two things the
// blend below takes from it, the blocker (group_cast: -1 none, -2 near the moving lamp, else the far
// blocker's swing, 0 to 64; both only under a moving lamp) and the follow evidence e (+1 near, -1
// further off, 0 free; under a lamp that stands too).
const float CAST_FREE = -1.0;       // free, or no ray to the strongest lamp: blocker -1, e 0
const float CAST_NEAR = -2.0;       // blocked near the moving lamp: blocker -2, e +1
const float CAST_NEAR_STILL = -3.0; // blocked near the lamp, which stands: blocker -1, e +1
const float CAST_FAR_STILL = -4.0;  // blocked further off, the lamp stands: blocker -1, e -1
const float CAST_TAKEN = -5.0;      // HALF_TAKEN (the block's answer, no ray): blocker -1
                                    // (0 or more: blocked further off under the moving lamp, the
                                    // blocker's swing; e -1)
// The resolve's tile: the workgroup's 8x8 pixels (8x8 first-pass pixels, two apart, in the
// half-resolution build's first pass) and two more on every side, so that the 5x5 window of every
// pixel lies wholly in it, centred on the pixel.
const int TILE_SIDE = 12;
shared float tile_answer[144];
shared float tile_cast[144];

// The follow evidence e a cast code stands for.
float castEvidence(float c) {
    if (c >= 0.0 || (c < -3.5 && c > -4.5)) {
        return -1.0;
    }
    return c < -1.5 && c > -3.5 ? 1.0 : 0.0;
}

// The trace's texel for pixel p (one off the screen is not stored). answer below 0: none. top: the
// strongest lamp's record (0: none); records start on 16-word steps below 2^20 (vk_point_shadow.cpp
// static_asserts), anything else is stored as none.
void storeAnswer(ivec2 p, float answer, float code, uint top) {
    if (all(lessThan(p, ivec2(size)))) {
        const uint at = (top & 15u) == 0u && top < (1u << 20u) ? top >> 4u : 0u;
        imageStore(lamp_answers, p,
                   uvec4(floatBitsToUint(answer), (packHalf2x16(vec2(0.0, code)) & 0xFFFF0000u) | at, 0u, 0u));
    }
}

// The resolve's tile, loaded by the whole workgroup (every invocation calls it, and a barrier
// follows). lo: the workgroup's first pixel; apart: 1, or 2 between first-pass pixels. A place
// outside the pass's rect or the screen has no answer: nothing traced it this frame.
// bbport (r61_lamp-window-cost): cell i of the tile, as r60 loaded every cell.
void loadCell(uint i, ivec2 lo, int apart) {
    const ivec2 q = lo + apart * (ivec2(int(i % 12u), int(i / 12u)) - 2);
    float a = -1.0, c = CAST_FREE;
    if (all(greaterThanEqual(q, rect.xy)) && all(lessThan(q, rect.zw)) && all(lessThan(q, ivec2(size)))) {
        const uvec2 t = imageLoad(lamp_answers, q).xy;
        a = uintBitsToFloat(t.x);
        c = unpackHalf2x16(t.y).y;
    }
    tile_answer[i] = a;
    tile_cast[i] = c;
}

// bbport (r61_lamp-window-cost): the centre cell of invocation lid, (lid + 2), is the place
// lo + apart * lid, which is the invocation's own pixel; main has loaded that texel already (own,
// under the same test: own_in), so the invocation writes it there, and only the 80 cells of the
// ring around the workgroup are loaded (one or two loads an invocation, in place of r60's two or
// three of all 144 cells, 64 of which every invocation had loaded once more for itself). Every cell
// holds the same bits as r60's: the same texel, decoded the same way, or the same "no answer".
void loadTile(ivec2 lo, int apart, bool own_in, uvec2 own) {
    const uint centre = (gl_LocalInvocationID.y + 2u) * 12u + gl_LocalInvocationID.x + 2u;
    tile_answer[centre] = own_in ? uintBitsToFloat(own.x) : -1.0;
    tile_cast[centre] = own_in ? unpackHalf2x16(own.y).y : CAST_FREE;
    for (uint j = gl_LocalInvocationIndex; j < 80u; j += 64u) {
        // rows 0 and 1 (cells 0 to 23), rows 10 and 11 (120 to 143), then columns 0, 1, 10 and 11
        // of rows 2 to 9
        uint i = j < 24u ? j : j + 96u;
        if (j >= 48u) {
            const uint k = j - 48u;
            i = (2u + k / 4u) * 12u + ((k & 3u) < 2u ? (k & 3u) : (k & 3u) + 8u);
        }
        loadCell(i, lo, apart);
    }
}
#endif

#ifdef HALF
// bbport (r32_lamp-half): more bits of `mode` (vk_point_shadow.cpp ModeHalf*).
const uint MODE_HALF_FIRST = 2u; // pixel (2x, 2y) of each 2x2 block, 16x16 pixels a workgroup
const uint MODE_HALF_FILL = 4u;  // the other three pixels of each block
const uint MODE_HALF_COUNT = 8u; // count this pass (half_counts)
// Second-pass answers to "take the block's answer?" (HalfAnswer); 4: a first-pass pixel.
const uint HALF_TAKEN = 0u, HALF_NO_ANSWER = 1u, HALF_DIFFER = 2u, HALF_SURFACE = 3u,
           HALF_FIRST_PIXEL = 4u;
const float HALF_AGREE = 1.0 / 64.0;

vec2 OctEncode(vec3 v) {
    v /= abs(v.x) + abs(v.y) + abs(v.z);
    const vec2 s = vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
    return v.z >= 0.0 ? v.xy : (1.0 - abs(v.yx)) * s;
}

vec3 OctDecode(vec2 e) {
    vec3 v = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    const vec2 s = vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
    if (v.z < 0.0) {
        v.xy = (1.0 - abs(v.yx)) * s;
    }
    return normalize(v);
}

// Second pass: whether this pixel can take the first pass's answer of its 2x2 block (v), and if
// not, why. Not exact: a caster thinner than two pixels between the first-pass pixels of a
// uniform neighbourhood is missed. Every block read here was written by this batch's first pass
// (its dispatch covers the rect's blocks, and it stores an answer or -1 for each).
uint HalfAnswer(ivec2 px, float z, vec3 n, out float v) {
    v = 1.0;
    const ivec2 block = px >> 1;
    const ivec2 lo = rect.xy >> 1;
    const ivec2 hi = (rect.zw - 1) >> 1;
    const vec4 own = imageLoad(half_answers, block);
    if (!(own.x >= 0.0)) {
        return HALF_NO_ANSWER;
    }
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            const float q = imageLoad(half_answers, clamp(block + ivec2(x, y), lo, hi)).x;
            if (!(q >= 0.0)) {
                return HALF_NO_ANSWER;
            }
            if (abs(q - own.x) > HALF_AGREE) {
                return HALF_DIFFER;
            }
        }
    }
    // The block's pixel on the same surface: the history's depth tolerance, normals within
    // about 25 degrees.
    if (!(abs(own.y - z) < 0.03 * z + 0.02) || !(dot(OctDecode(own.zw), n) > 0.9)) {
        return HALF_SURFACE;
    }
    v = own.x;
    return HALF_TAKEN;
}

// half_counts words: 0 counted second passes, 1 first-pass pixels traced, 2 their rays, 3
// first-pass pixels from history, 4 second-pass pixels that took the first pass's answer, 5
// second-pass pixels traced, 6 their rays, 7 second-pass pixels from history, 8 second-pass
// workgroups with a lamp-shadowed pixel, 9 of those with no ray, 10-12 why second-pass pixels
// were traced (HALF_NO_ANSWER, HALF_DIFFER, HALF_SURFACE).
const uint HALF_SLOTS = 13u;
shared uint half_n[HALF_SLOTS];
shared uint half_done;

// Every invocation of a workgroup that got past its tile list calls this once; the last one
// adds the workgroup's counts to half_counts.
void HalfCount(bool first, uint slot, uint why) {
    if ((mode & MODE_HALF_COUNT) == 0u) {
        return;
    }
    if (slot != 0u) {
        atomicAdd(half_n[slot], 1u);
    }
    if (half_rays != 0u) {
        atomicAdd(half_n[first ? 2u : 6u], half_rays);
    }
    if (!first && why >= HALF_NO_ANSWER && why <= HALF_SURFACE) {
        atomicAdd(half_n[9u + why], 1u);
    }
    memoryBarrierShared();
    if (atomicAdd(half_done, 1u) != 63u) {
        return;
    }
    memoryBarrierShared();
    for (uint i = 1u; i < HALF_SLOTS; ++i) {
        const uint v = atomicAdd(half_n[i], 0u);
        if (v != 0u) {
            atomicAdd(half_counts.n[i], v);
        }
    }
    if (!first && atomicAdd(half_n[4], 0u) + atomicAdd(half_n[5], 0u) + atomicAdd(half_n[7], 0u) != 0u) {
        atomicAdd(half_counts.n[8], 1u);
        if (atomicAdd(half_n[6], 0u) == 0u) {
            atomicAdd(half_counts.n[9], 1u);
        }
    }
}
#endif

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        shared_inverse = transpose(mat4(row(0u), row(4u), row(8u), row(12u)));
        group_count = 0u;
        group_trace = 0u;
#ifdef HALF
        for (uint i = 0u; i < HALF_SLOTS; ++i) {
            half_n[i] = 0u;
        }
        half_done = 0u;
        if ((mode & (MODE_HALF_FILL | MODE_HALF_COUNT)) == (MODE_HALF_FILL | MODE_HALF_COUNT) &&
            gl_WorkGroupID.xy == uvec2(rect.xy) >> 3u) {
            atomicAdd(half_counts.n[0], 1u); // one counted pass (its first workgroup)
        }
#endif
    }
    barrier();
#ifdef HALF
    // bbport (r32_lamp-half): a first-pass workgroup covers 16x16 pixels.
    const bool first = (mode & MODE_HALF_FIRST) != 0u, fill = (mode & MODE_HALF_FILL) != 0u;
    const int span = first ? 16 : 8;
    const ivec2 group_lo = ivec2(gl_WorkGroupID.xy) * span;
    const ivec2 group_hi = group_lo + span;
#else
    const ivec2 group_lo = ivec2(gl_WorkGroupID.xy) * 8;
    const ivec2 group_hi = group_lo + 8;
#endif
#ifdef CENTRED
    // bbport (r60_lamp-centred-window): the resolve lists the tiles as its trace did (the same test,
    // so the same workgroups return below: one without a tile does in both, as with value 1, and
    // its trace has stored "no answer" for its pixels, which the windows around it read from the
    // image), but casts no ray (tile_count below)
#ifdef RESOLVE
    const bool resolve_mode = true; // bbport (r61_lamp-window-cost): every dispatch of this build
    const bool trace_mode = false;
#else
    const bool resolve_mode = (mode & MODE_RESOLVE) != 0u;
    const bool trace_mode = (mode & MODE_TRACE) != 0u;
#endif
    // bbport (r61_lamp-window-cost): the resolve lists no tile. Each invocation loads its own
    // pixel's texel of the answers (r60 loaded it below, and once more into the tile), and the
    // workgroup goes on only if its trace answered one of its pixels (group_count then 1, else 0).
    // In logic the same result as r60's list (in bits not proven: this build's SPIR-V is new): a
    // workgroup without a tile has no answer (its trace stored none),
    // and in one with tiles but no answer r60's resolve wrote nothing (its pixels are not live, no
    // lamp light is left in them, and the -1 block answers of the half-resolution build's first pass
    // are what its trace stored): it now returns here, before loading the tune, the light, depth and
    // the tile.
    uvec2 own = uvec2(0u);   // the texel (loaded where the pixel lies in the pass's rect)
    bool own_in = false;     // the pixel lies in the rect and on the screen (loadCell's test)
    bool own_answer = false; // r60's `live` after its load: in the rect, not the first pass's
                             // pixel (second pass), and the trace answered it
    if (resolve_mode) {
#ifdef HALF
        const ivec2 p = ivec2(gl_GlobalInvocationID.xy) * (first ? 2 : 1);
        const bool mine = !fill || ((p.x | p.y) & 1) != 0;
#else
        const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
        const bool mine = true;
#endif
        if (p.x >= rect.x && p.y >= rect.y && p.x < rect.z && p.y < rect.w) {
            own = imageLoad(lamp_answers, p).xy;
            own_in = all(lessThan(p, ivec2(size)));
            own_answer = mine && uintBitsToFloat(own.x) >= 0.0;
        }
        if (own_answer) {
            atomicOr(group_count, 1u);
        }
    } else
#endif
    for (uint t = gl_LocalInvocationIndex; t < light_count; t += 64u) {
        if (inside(t, group_lo, group_hi)) {
            const uint slot = atomicAdd(group_count, 1u);
            if (slot < MAX_GROUP_TILES) {
                group_tiles[slot] = t;
            }
        }
    }
    barrier();
    const uint listed = group_count;
    if (listed == 0u) {
#ifdef HALF
#ifdef CENTRED
        if (first && !resolve_mode) { // (bbport r60_lamp-centred-window: the trace stored it)
#else
        if (first) {
#endif
            imageStore(half_answers, ivec2(gl_GlobalInvocationID.xy), vec4(-1.0)); // no answer
        }
#endif
#ifdef CENTRED
        if (trace_mode) { // bbport (r60_lamp-centred-window): no answer here
#ifdef HALF
            const ivec2 p = ivec2(gl_GlobalInvocationID.xy) * (first ? 2 : 1);
            if (!fill || ((p.x | p.y) & 1) != 0) { // (not over the first pass's pixel)
                storeAnswer(p, -1.0, CAST_FREE, 0u);
            }
#else
            storeAnswer(ivec2(gl_GlobalInvocationID.xy), -1.0, CAST_FREE, 0u);
#endif
        }
#endif
        return;
    }
    loadTune(); // bbport (r41_lamp-shadows): after the return of a workgroup with no tile
    const bool overflow = listed > MAX_GROUP_TILES;
#ifdef CENTRED
    const uint tile_count = resolve_mode ? 0u : overflow ? light_count : listed; // (r60: the resolve weighs no lamp)
#else
    const uint tile_count = overflow ? light_count : listed;
#endif
    const uint history_at = floatBitsToUint(length_m);
    const uint history_flags = history_at != 0u ? data.d[history_at] : 0u;
#ifdef HALF
    // bbport (r44_half-area-lamp): a block's answer is shared by its pixels, so at half
    // resolution a lamp is an area lamp only where its answers are averaged over the frames
    if ((history_flags & HISTORY_BLEND) == 0u) {
        t_radius = 0.0;
    }
#endif
#ifdef CENTRED
    // bbport (r60_lamp-centred-window): the two dispatches' roles, the same for the whole workgroup
    // (push constant, tuning word, history flags). Only the pass that averages has the window; views
    // 2 and 3 (lamps, rays) are drawn by one dispatch (the host does not split them). A split the
    // shader does not take is done whole by its trace dispatch, and its resolve does nothing.
    const bool centred = t_centred && (history_flags & HISTORY_BLEND) != 0u && t_view != 2u && t_view != 3u;
#ifdef RESOLVE
    // bbport (r61_lamp-window-cost): as below with resolve_mode set; past the return, centred
    if (!centred) {
        return;
    }
    const bool trace_only = false;
    const bool resolve = true;
#else
    const bool trace_only = trace_mode && centred;
    const bool resolve = resolve_mode && centred;
    if (resolve_mode && !centred) {
        return;
    }
#endif
#ifdef HALF
    const bool resolve_normal = first; // the first pass's block answer holds the normal
    // The window's places: first-pass pixels two apart in the first pass (25 answers within 4
    // pixels, as the workgroup-confined window had); every pixel in the second, whose window then
    // takes the first pass's answers too (the confined one could not: they were not in its
    // workgroup's shared arrays).
    const int resolve_apart = first ? 2 : 1;
#else
    const bool resolve_normal = false;
    const int resolve_apart = 1;
#endif
#endif

#ifdef HALF
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy) * (first ? 2 : 1);
#else
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
#endif
    bool live = px.x >= rect.x && px.y >= rect.y && px.x < rect.z && px.y < rect.w;
#ifdef HALF
    // The second pass leaves pixel (2x, 2y) of each block to the first (which also moved its
    // lamp light: its lamp texels are zero now, so it is not `lit` here either).
    const bool done_first = fill && ((px.x | px.y) & 1) == 0;
    live = live && !done_first;
#endif
#ifdef CENTRED
    // bbport (r60_lamp-centred-window): the resolve shadows the pixels the trace answered for. The
    // tests below then hold for them again: where it answered, the trace changed none of their inputs.
    // bbport (r61_lamp-window-cost): the texel is the one loaded above (`stored` is read only for a
    // pixel that stays live), and the tile's ring is loaded here, before the pixel's own loads below,
    // so that they are in flight together (r60 loaded the whole tile after them; nothing between
    // writes the answers or reads the tile).
    const uvec2 stored = own;
    if (resolve) {
        live = live && own_answer;
        loadTile(group_lo, resolve_apart, own_in, own);
    }
#endif
    // s: the light without the lamps, d: the lamps' light.
    vec3 s0 = vec3(0.0), d0 = vec3(0.0), s1 = vec3(0.0), d1 = vec3(0.0);
    const bool apart = (mode & MODE_APART) != 0u;
    // apart: the pixel has lamp light to move into the light targets, shadowed or not.
    bool lit = false;
    if (apart) {
#ifdef CENTRED
        // bbport (r61_lamp-window-cost): the resolve reads the lamp light only of a pixel its trace
        // answered. No other pixel of a resolve that got this far has any left: its trace ran past
        // the tile list and moved it into the light targets, zeroing snap0 and snap1 (below: lit,
        // not live), or (the first pass's pixels, in the second pass) the first pass did. So r60's
        // loads gave lit false there, and d0, d1, s0 and s1 stay 0 as they gave.
        if ((!resolve || live) && px.x < int(size.x) && px.y < int(size.y)) {
#else
        if (px.x < int(size.x) && px.y < int(size.y)) {
#endif
            d0 = imageLoad(snap0, px).rgb;
            d1 = imageLoad(snap1, px).rgb;
            lit = any(notEqual(d0, vec3(0.0))) || any(notEqual(d1, vec3(0.0)));
        }
        if (lit) {
            s0 = imageLoad(cur0, px).rgb;
            s1 = imageLoad(cur1, px).rgb;
        }
        live = live && lit;
    } else if (live) {
        s0 = imageLoad(snap0, px).rgb;
        s1 = imageLoad(snap1, px).rgb;
        const vec3 c0 = imageLoad(cur0, px).rgb;
        const vec3 c1 = imageLoad(cur1, px).rgb;
        live = !(all(lessThanEqual(c0, s0)) && all(lessThanEqual(c1, s1)));
        d0 = max(c0 - s0, vec3(0.0));
        d1 = max(c1 - s1, vec3(0.0));
    }
    const vec2 uv = (vec2(px) + 0.5) / size;
    vec3 P = vec3(0.0);
    float fade = 0.0;
    if (live) {
        const float depth = textureLod(depth_tex, uv, 0.0).x;
        live = depth < 1.0 && depth > 0.0;
        if (live) {
            P = viewPosAt(uv, depth);
            live = P.z > 0.0;
            fade = 1.0 - smoothstep(fade_start_m, fade_end_m, P.z);
            live = live && fade > 0.0;
        }
    }
    if (live) {
        const vec3 delta = d0 + d1;
        const vec3 base_light = s0 + s1;
        live = max(max(delta.r, delta.g), delta.b) * strength * fade >
