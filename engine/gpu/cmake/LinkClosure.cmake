# bbport: link closure of a static library, for linking it outside CMake (build.sh links
# bb-probe.exe with the C driver on Windows). Writes one linker argument per line: the library
# itself, then its transitive dependencies in an order that satisfies GNU ld and lld (a library
# is listed after every library that uses it).

function(_bb_link_closure_visit item stack out_items out_cycle)
    set(${out_items} "" PARENT_SCOPE)
    set(${out_cycle} FALSE PARENT_SCOPE)
    if (item MATCHES "^\\$<LINK_ONLY:(.*)>$")
        set(item "${CMAKE_MATCH_1}")
    endif()
    if (item STREQUAL "" OR item MATCHES "^\\$<")
        return()
    endif()
    if (TARGET "${item}")
        get_target_property(aliased "${item}" ALIASED_TARGET)
        if (aliased)
            set(item "${aliased}")
        endif()
        if ("${item}" IN_LIST stack)
            set(${out_cycle} TRUE PARENT_SCOPE)
            return()
        endif()
        set(memo "_BB_LINK_MEMO_${item}")
        get_property(cached GLOBAL PROPERTY "${memo}" SET)
        if (cached)
            get_property(items GLOBAL PROPERTY "${memo}")
            set(${out_items} "${items}" PARENT_SCOPE)
            return()
        endif()
        list(APPEND stack "${item}")
        set(items "")
        set(cycle FALSE)
        get_target_property(type "${item}" TYPE)
        get_target_property(imported "${item}" IMPORTED)
        if (type STREQUAL "SHARED_LIBRARY")
            list(APPEND items "$<TARGET_LINKER_FILE:${item}>")
        elseif (type STREQUAL "STATIC_LIBRARY" OR (imported AND type STREQUAL "UNKNOWN_LIBRARY"))
            list(APPEND items "$<TARGET_FILE:${item}>")
        endif()
        get_target_property(options "${item}" INTERFACE_LINK_OPTIONS)
        if (options)
            foreach(option IN LISTS options)
                if (NOT option STREQUAL "")
                    list(APPEND items "${option}")
                endif()
            endforeach()
        endif()
        get_target_property(deps "${item}" INTERFACE_LINK_LIBRARIES)
        if (deps)
            foreach(dep IN LISTS deps)
                _bb_link_closure_visit("${dep}" "${stack}" child_items child_cycle)
                if (NOT child_items STREQUAL "")
                    list(APPEND items "${child_items}")
                endif()
                if (child_cycle)
                    set(cycle TRUE)
                endif()
            endforeach()
        endif()
        # Keeping the last occurrence within a subtree preserves the final keep-last order.
        # Every edge still appends that subtree in the original traversal order.
        if (NOT items STREQUAL "")
            list(REVERSE items)
            list(REMOVE_DUPLICATES items)
            list(REVERSE items)
            # An empty element alone needs a separator to survive list serialization.
            if (items STREQUAL "")
                set(items ";")
            endif()
        endif()
        # A back edge depends on the caller's stack, so this result cannot be reused.
        if (NOT cycle)
            set_property(GLOBAL PROPERTY "${memo}" "${items}")
            set_property(GLOBAL APPEND PROPERTY _BB_LINK_MEMOS "${memo}")
        endif()
        set(${out_items} "${items}" PARENT_SCOPE)
        set(${out_cycle} "${cycle}" PARENT_SCOPE)
    elseif (item MATCHES "^-" OR IS_ABSOLUTE "${item}")
        set(${out_items} "${item}" PARENT_SCOPE)
    else()
        set(${out_items} "-l${item}" PARENT_SCOPE)
    endif()
endfunction()

function(bb_write_link_closure target output)
    _bb_link_closure_visit(${target} "" items cycle)
    get_property(memos GLOBAL PROPERTY _BB_LINK_MEMOS)
    foreach(memo IN LISTS memos)
        set_property(GLOBAL PROPERTY "${memo}")
    endforeach()
    set_property(GLOBAL PROPERTY _BB_LINK_MEMOS)
    # Keep the last occurrence of each item: dependencies end up after all their users.
    list(REVERSE items)
    list(REMOVE_DUPLICATES items)
    list(REVERSE items)
    # SDL3's pkg-config adds -mwindows (GUI subsystem): bb-probe keeps its console output.
    list(REMOVE_ITEM items -mwindows)
    # The C++ runtime (the exe is linked by the C driver) and the Windows libraries the vendored
    # code calls directly; onecore last (CreateFileMapping2 and the other Windows 10 memory APIs
    # kernel32's import library lacks). CLANG64: libc++, whose threads and locks are Win32's own.
    if (CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        set(cxx_runtime -lc++)
    else()
        set(cxx_runtime -lstdc++)
    endif()
    list(APPEND items ${cxx_runtime} -lwinmm -lws2_32 -lbcrypt -lole32 -lshell32 -luser32 -lpsapi
        -lkernel32 -lonecore)
    list(JOIN items "\n" content)
    file(GENERATE OUTPUT "${output}" CONTENT "${content}\n" NEWLINE_STYLE UNIX)
endfunction()
